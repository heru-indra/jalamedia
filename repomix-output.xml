          letterSpacing: "0.03em", lineHeight: 1.7,
          fontFamily: "'DM Mono', monospace",
        }}>
          💡 {commissionNote}
        </div>
      )}

      {/* CTA */}
      <Link href={ctaHref} style={{
        display: "flex", alignItems: "center", justifyContent: "center", gap: 8,
        padding: "13px 24px",
        background: highlighted ? "#c9a060" : isCommission ? "rgba(106,170,56,0.12)" : "transparent",
        border: `1px solid ${
          highlighted  ? "#c9a060" :
