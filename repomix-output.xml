            <div style={{
              padding: "18px 16px", background: "rgba(201,160,96,0.04)",
              border: "1px solid rgba(201,160,96,0.12)", borderRadius: 6,
              fontSize: 11, color: "#555", lineHeight: 1.8,
              letterSpacing: "0.04em", fontFamily: "'DM Mono', monospace",
