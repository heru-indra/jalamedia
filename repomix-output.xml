// src/app/jelajahi/page.tsx
// Halaman publik — dua jenis tampilan:
//   Premium (Basic/Pro/Komisi) → card besar dengan cover image
//   Standar (Free)             → list item kecil tanpa gambar mencolok

import "@/app/jelajahi.css";
import Link from "next/link";
import Image from "next/image";
import { Navbar } from "@/components/navbar";
import { CategoryCards } from "@/components/category-cards";
import { db } from "@/db";
import { events, categories, user } from "@/db/schema";
import { eq, desc, and } from "drizzle-orm";
import { TIER_CONFIG } from "@/lib/tiers";
import type { PricingTier } from "@/lib/tiers";
import "@/app/jelajahi.css";

// ── Helpers ───────────────────────────────────────────────────────────────────

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric", month: "short", year: "numeric",
  }).format(date);
}

function formatPrice(price: string | null) {
  const n = Number(price);
  if (!n) return "Gratis";
  return new Intl.NumberFormat("id-ID", {
    style: "currency", currency: "IDR", maximumFractionDigits: 0,
  }).format(n);
}

// ── Page ──────────────────────────────────────────────────────────────────────

interface Props {
  searchParams: Promise<{ category?: string }>;
}

export default async function PublicEventsPage({ searchParams }: Props) {
  const { category: slug } = await searchParams;

  const activeCategory = slug
    ? await db.select().from(categories).where(eq(categories.slug, slug)).then(r => r[0] ?? null)
    : null;

  const conditions = [eq(events.status, "published")];
  if (activeCategory) conditions.push(eq(events.categoryId, activeCategory.id));

  const rows = await db
    .select({ event: events, category: categories, organizer: user })
    .from(events)
    .leftJoin(categories, eq(events.categoryId, categories.id))
    .leftJoin(user, eq(events.userId, user.id))
    .where(and(...conditions))
    .orderBy(desc(events.startDate))
    .limit(48);

  // Pisahkan premium vs standar berdasarkan tier organizer
  const premiumEvents  = rows.filter(r => {
    const tier = (r.organizer?.pricingTier ?? "free") as PricingTier;
    return TIER_CONFIG[tier].listingStyle === "premium";
  });
  const standardEvents = rows.filter(r => {
    const tier = (r.organizer?.pricingTier ?? "free") as PricingTier;
    return TIER_CONFIG[tier].listingStyle === "standard";
  });

  return (
    <>
<Navbar />

      {/* Hero */}
      <div className="ev-hero">
        <div className="ev-eyebrow">Jelajahi Event</div>
        <h1 className="ev-title">
          {activeCategory
            ? <>{activeCategory.emoji} <em>{activeCategory.name}</em></>
            : <>Event <em>terbaik</em> untukmu</>
          }
        </h1>
        <p className="ev-sub">
          {activeCategory
            ? `Semua event ${activeCategory.name} yang sedang berlangsung.`
            : "Temukan workshop, konferensi, festival, dan berbagai event menarik dari seluruh Indonesia."
          }
        </p>
      </div>

      {/* Category banner */}
      {activeCategory && (
        <div className="ev-cat-banner">
          <div className="ev-cat-left">
            <span style={{ fontSize: 22 }}>{activeCategory.emoji}</span>
            <span>Kategori <strong style={{ fontWeight: 400, color: "#f0e8d8" }}>{activeCategory.name}</strong></span>
          </div>
          <Link href="/jelajahi" className="ev-cat-clear">✕ Lihat semua</Link>
        </div>
      )}

      {/* Category cards — jika tidak ada filter */}
      {!activeCategory && (
        <>
          <hr className="section-divider" />
          <CategoryCards baseHref="/jelajahi" showHeading={false} cols={3} />
        </>
      )}

      <hr className="section-divider" />

      <div className="ev-main">

        {rows.length === 0 ? (
          <div className="ev-empty">
            <div style={{ fontSize: 40, marginBottom: 16 }}>🔍</div>
            <div className="ev-empty-title">Belum ada event</div>
            <p className="ev-empty-sub">Belum ada event yang dipublikasi saat ini.</p>
          </div>
        ) : (
          <>
            {/* ── PREMIUM LISTING ── */}
            {premiumEvents.length > 0 && (
              <div style={{ marginBottom: 48 }}>
                <div className="ev-section-label">
                  <div className="ev-section-label-text">
                    Event <em>Unggulan</em>
                  </div>
                  <div className="ev-section-label-line" />
                  <div className="ev-section-label-count">
                    {premiumEvents.length} event
                  </div>
                </div>

                <div className="prem-grid">
                  {premiumEvents.map(({ event, category, organizer }) => {
                    const price = Number(event.ticketPrice);
                    return (
                      <Link key={event.id} href={`/events/${event.id}`} className="prem-card">
                        {/* Cover */}
                        <div className="prem-cover">
                          {event.coverImage ? (
                            <Image
                              src={event.coverImage}
                              alt={event.title}
                              fill
                              style={{ objectFit: "cover" }}
                              sizes="(max-width: 560px) 100vw, (max-width: 960px) 50vw, 33vw"
                            />
                          ) : (
                            <div className="prem-cover-placeholder">
                              <span className="prem-cover-emoji">
                                {category?.emoji ?? "📅"}
                              </span>
                            </div>
                          )}
                          {category && (
                            <span className="prem-cover-cat">
                              {category.emoji} {category.name}
                            </span>
                          )}
                          {event.isFeatured && (
                            <span className="prem-cover-featured">★ Featured</span>
                          )}
                        </div>

                        {/* Body */}
                        <div className="prem-body">
                          <div className="prem-title">{event.title}</div>
                          <div className="prem-meta">
                            <div className="prem-meta-row">
                              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round">
                                <rect x="1" y="1.5" width="10" height="9" rx="1.5"/>
                                <line x1="1" y1="5" x2="11" y2="5"/>
                                <line x1="4" y1="0" x2="4" y2="3"/>
                                <line x1="8" y1="0" x2="8" y2="3"/>
                              </svg>
                              {formatDate(new Date(event.startDate))}
                            </div>
                            <div className="prem-meta-row">
                              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round">
                                <path d="M6 1a3.5 3.5 0 0 1 3.5 3.5C9.5 7.5 6 11 6 11S2.5 7.5 2.5 4.5A3.5 3.5 0 0 1 6 1z"/>
                                <circle cx="6" cy="4.5" r="1.2"/>
                              </svg>
                              {event.location.length > 32 ? event.location.slice(0,32) + "…" : event.location}
                            </div>
                          </div>
                          <div className="prem-footer">
                            <div className={`prem-price ${price === 0 ? "free" : "paid"}`}>
                              {price === 0 ? "Gratis" : `Rp ${price.toLocaleString("id-ID")}`}
                            </div>
                            {organizer && (
                              <div className="prem-org">{organizer.name}</div>
                            )}
                          </div>
                        </div>
                      </Link>
                    );
                  })}
                </div>
              </div>
            )}

            {/* ── STANDARD LISTING ── */}
            {standardEvents.length > 0 && (
              <div>
                <div className="ev-section-label">
                  <div className="ev-section-label-text">Event Lainnya</div>
                  <div className="ev-section-label-line" />
                  <div className="ev-section-label-count">{standardEvents.length} event</div>
                </div>

                <div className="std-section">
                  <div className="std-header">
                    <span>Nama Event</span>
                    <span>Tanggal</span>
                    <span>Lokasi</span>
                    <span style={{ textAlign: "right" }}>Harga</span>
                  </div>

                  {standardEvents.map(({ event, category }) => {
                    const price = Number(event.ticketPrice);
                    return (
                      <Link key={event.id} href={`/events/${event.id}`} className="std-item">
                        <div className="std-title-wrap">
                          <div className="std-title">{event.title}</div>
                          {category && (
                            <div className="std-cat">
                              {category.emoji} {category.name}
                            </div>
                          )}
                        </div>
                        <div className="std-date">
                          {formatDate(new Date(event.startDate))}
                        </div>
                        <div className="std-location">
                          {event.location.length > 22 ? event.location.slice(0,22) + "…" : event.location}
                        </div>
                        <div className={`std-price ${price === 0 ? "free" : ""}`}>
                          {formatPrice(event.ticketPrice)}
                        </div>
                      </Link>
                    );
                  })}
                </div>
              </div>
            )}
          </>
        )}
      </div>
    </>
  );
}
</file>

