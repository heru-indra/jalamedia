import Link from "next/link";
import "@/app/homepage.css";
import { Navbar } from "@/components/navbar";
import { CategoryCards } from "@/components/category-cards";

// ── Hero background image ─────────────────────────────────────────────────────
// Ganti URL di bawah untuk mengubah background hero.
// Gunakan gambar landscape beresolusi tinggi (min 1920×1080).
// Contoh sumber gratis: unsplash.com, pexels.com
//
// Kosongkan string ("") untuk kembali ke tampilan default (grid + glow).
const HERO_BG_IMAGE = "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=1920&q=80";
//                    ↑ Ganti URL ini
// ─────────────────────────────────────────────────────────────────────────────

// ── Icons ─────────────────────────────────────────────────────────────────────

function IconCheck() {
  return (
    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round">
      <polyline points="2 8 5.5 11.5 13 3.5" />
    </svg>
  );
}

function IconX() {
  return (
    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round">
      <line x1="3" y1="3" x2="10" y2="10" />
      <line x1="10" y1="3" x2="3" y2="10" />
    </svg>
  );
}

function IconArrow() {
  return (
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round">
      <line x1="2" y1="8" x2="13" y2="8" />
      <polyline points="9 4 13 8 9 12" />
    </svg>
  );
}

// ── Feature card ──────────────────────────────────────────────────────────────

function FeatureCard({
  num,
  title,
  desc,
  tags,
}: {
  num: string;
  title: string;
  desc: string;
  tags: string[];
}) {
  return (
    <div style={{
      background: "#111",
      border: "1px solid #1e1e1e",
      borderRadius: 12,
      padding: "32px",
      position: "relative",
      overflow: "hidden",
      transition: "border-color 0.2s",
    }}>
      <div style={{
        position: "absolute", top: 0, left: 0, right: 0, height: 2,
        background: "linear-gradient(to right, transparent, rgba(201,160,96,0.4), transparent)",
      }} />
      <div style={{
        fontFamily: "'Cormorant Garamond', serif",
        fontSize: 48, fontWeight: 300, color: "#1e1e1e",
        lineHeight: 1, marginBottom: 20, letterSpacing: "-0.03em",
      }}>
        {num}
      </div>
      <div style={{
        fontFamily: "'Cormorant Garamond', serif",
        fontSize: 22, fontWeight: 300, color: "#f0e8d8",
        marginBottom: 12, letterSpacing: "-0.01em",
      }}>
        {title}
      </div>
      <p style={{
        fontSize: 13, color: "#666",
        lineHeight: 1.8, letterSpacing: "0.03em",
        marginBottom: 20, fontFamily: "'DM Mono', monospace",
      }}>
        {desc}
      </p>
      <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
        {tags.map((tag) => (
          <span key={tag} style={{
            fontSize: 10, padding: "3px 9px",
            background: "rgba(201,160,96,0.08)",
            border: "1px solid rgba(201,160,96,0.2)",
            borderRadius: 3, color: "#c9a060",
            letterSpacing: "0.1em", textTransform: "uppercase",
            fontFamily: "'DM Mono', monospace",
          }}>
            {tag}
          </span>
        ))}
      </div>
    </div>
  );
}

// ── Pricing card ──────────────────────────────────────────────────────────────

function PricingCard({
  name,
  price,
  period,
  desc,
  features,
  cta,
  ctaHref,
  highlighted,
  badge,
  commissionNote,
}: {
  name: string;
  price: string;
  period: string;
  desc: string;
  features: { text: string; included: boolean }[];
  cta: string;
  ctaHref: string;
  highlighted?: boolean;
  badge?: string;
  commissionNote?: string;
}) {
  const isCommission = !!commissionNote;

  return (
    <div style={{
      background: highlighted ? "#141414" : isCommission ? "#0f110e" : "#0f0f0f",
      border: `1px solid ${
        highlighted    ? "rgba(201,160,96,0.4)" :
        isCommission   ? "rgba(106,170,56,0.25)" :
        "#1e1e1e"
      }`,
      borderRadius: 12,
      padding: "32px 26px",
      position: "relative",
      overflow: "hidden",
      flex: 1,
    }}>
      {/* Accent top line */}
      <div style={{
        position: "absolute", top: 0, left: 0, right: 0, height: 2,
        background: highlighted
          ? "linear-gradient(to right, transparent, #c9a060, transparent)"
          : isCommission
          ? "linear-gradient(to right, transparent, #6aaa38, transparent)"
          : "linear-gradient(to right, transparent, #333, transparent)",
      }} />

      {/* Badge */}
      {badge && (
        <div style={{
          position: "absolute", top: 16, right: 16,
          fontSize: 9, padding: "4px 10px",
          background: isCommission ? "rgba(106,170,56,0.12)" : "rgba(201,160,96,0.15)",
          border: `1px solid ${isCommission ? "rgba(106,170,56,0.3)" : "rgba(201,160,96,0.3)"}`,
          borderRadius: 3,
          color: isCommission ? "#6aaa38" : "#c9a060",
          letterSpacing: "0.12em", textTransform: "uppercase",
          fontFamily: "'DM Mono', monospace",
        }}>
          {badge}
        </div>
      )}

      {/* Tier name */}
      <div style={{
        fontSize: 11, color: "#555",
        letterSpacing: "0.18em", textTransform: "uppercase",
        marginBottom: 12, fontFamily: "'DM Mono', monospace",
      }}>
        {name}
      </div>

      {/* Price */}
      <div style={{
        fontFamily: "'Cormorant Garamond', serif",
        fontSize: 52, fontWeight: 300,
        color: highlighted ? "#f0e8d8" : isCommission ? "#6aaa38" : "#888",
        lineHeight: 1, letterSpacing: "-0.03em",
        marginBottom: 4,
      }}>
        {price}
      </div>
      <div style={{
        fontSize: 12, color: "#444",
        letterSpacing: "0.06em", marginBottom: 8,
        fontFamily: "'DM Mono', monospace",
      }}>
        {period}
      </div>

      {/* Description */}
      <p style={{
        fontSize: 13, color: "#555",
        letterSpacing: "0.03em", lineHeight: 1.7,
        marginBottom: 20, fontFamily: "'DM Mono', monospace",
        borderBottom: "1px solid #1a1a1a",
        paddingBottom: 20,
      }}>
        {desc}
      </p>

      {/* Features */}
      <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 20 }}>
        {features.map((f, i) => (
          <div key={i} style={{
