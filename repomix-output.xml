  color: var(--c-text-4); flex-shrink: 0;
}
.det-info-icon.accent { color: var(--c-gold); }
.det-info-label { font-size: var(--fs-xs); color: var(--c-text-5); letter-spacing: var(--ls-label); text-transform: uppercase; margin-bottom: 3px; }
.det-info-value { font-size: var(--fs-base); color: var(--c-text-2); letter-spacing: var(--ls-tight); }
.det-info-value.accent { color: var(--c-gold); }

/* Timeline */
.det-timeline { display: flex; flex-direction: column; }
.det-tl-item { display: flex; gap: 16px; }
.det-tl-dot-wrap { display: flex; flex-direction: column; align-items: center; width: 18px; }
.det-tl-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--c-gold); border: 2px solid var(--c-bg); flex-shrink: 0; margin-top: 4px;
}
.det-tl-dot.dim { background: var(--c-border); }
.det-tl-line { flex: 1; width: 1px; background: var(--c-border); margin: 4px 0; min-height: 24px; }
.det-tl-content { padding-bottom: 20px; flex: 1; }
.det-tl-label { font-size: var(--fs-xs); color: var(--c-text-5); letter-spacing: var(--ls-label); text-transform: uppercase; margin-bottom: 3px; }
.det-tl-value { font-size: var(--fs-sm); color: var(--c-text-3); letter-spacing: var(--ls-tight); }

/* Sidebar cards */
.det-side-card {
  background: var(--c-bg-2); border: 1px solid var(--c-border); border-radius: var(--r-lg);
  overflow: hidden; margin-bottom: 14px;
}
.det-side-card-head {
  padding: 12px 18px; border-bottom: 1px solid var(--c-bg-3);
  font-size: var(--fs-label); color: var(--c-text-5); letter-spacing: var(--ls-label); text-transform: uppercase;
}
.det-side-card-body { padding: 4px 0; }
.det-stat-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 18px; border-bottom: 1px solid #0d0d0d;
}
.det-stat-row:last-child { border-bottom: none; }
.det-stat-key { font-size: var(--fs-sm); color: var(--c-text-5); letter-spacing: var(--ls-tight); }
.det-stat-val { font-size: var(--fs-sm); color: var(--c-text-3); letter-spacing: var(--ls-tight); text-align: right; }
.det-stat-val.accent { color: var(--c-gold); }
.det-stat-val.green  { color: var(--c-green); }

.det-timestamps { margin-top: 14px; }
.det-ts-item {
  display: flex; justify-content: space-between; padding: 6px 0;
  font-size: var(--fs-xs); color: var(--c-text-5); letter-spacing: 0.06em;
  border-bottom: 1px solid var(--c-bg-3);
}
.det-ts-item:last-child { border-bottom: none; }

/* Responsive */
@media (max-width: 900px) {
  .det-body { grid-template-columns: 1fr; }
  .det-main { border-right: none; border-bottom: 1px solid var(--c-bg-3); padding: 28px 24px; }
  .det-side { padding: 24px; position: static; }
  .det-hero { padding: 24px; }
}
@media (max-width: 640px) {
  .det-hero-top { flex-direction: column; }
  .det-hero-right { align-items: flex-start; }
}
</file>

<file path="app/globals.css">
/* ============================================================
   EVENTARA — Global Stylesheet
   src/app/globals.css
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Mono:wght@300;400;500&display=swap');

/* ── Design Tokens ─────────────────────────────────────────── */

:root {
  /* Colors */
  --c-bg:          #0a0a0a;
  --c-bg-2:        #0f0f0f;
  --c-bg-3:        #141414;
  --c-bg-4:        #1a1a1a;
  --c-border:      #1e1e1e;
  --c-border-2:    #252525;
  --c-border-3:    #2e2e2e;

  /* Text */
  --c-text:        #f0e8d8;   /* primary */
  --c-text-2:      #c0b8a8;   /* secondary */
  --c-text-3:      #888;      /* muted */
  --c-text-4:      #555;      /* dimmed */
  --c-text-5:      #333;      /* very dimmed */

  /* Accent */
  --c-gold:        #c9a060;
  --c-gold-light:  #d4b070;
  --c-gold-dim:    rgba(201,160,96,0.15);
  --c-gold-bg:     rgba(201,160,96,0.07);
  --c-gold-border: rgba(201,160,96,0.25);

  /* Status */
  --c-green:       #6aaa38;
  --c-green-bg:    rgba(106,170,56,0.1);
  --c-green-border:rgba(106,170,56,0.3);
  --c-red:         #e05a5a;
  --c-red-bg:      rgba(224,90,90,0.08);
  --c-red-border:  rgba(224,90,90,0.25);
  --c-orange:      #e09040;

  /* Typography */
  --font-serif:    'Cormorant Garamond', Georgia, serif;
  --font-mono:     'DM Mono', 'Fira Code', monospace;

  /* Font sizes — increased for contrast & readability */
  --fs-xs:   11px;
  --fs-sm:   13px;
  --fs-base: 15px;
  --fs-md:   17px;
  --fs-lg:   20px;
  --fs-xl:   24px;
  --fs-2xl:  32px;
  --fs-3xl:  42px;
  --fs-4xl:  56px;
  --fs-5xl:  72px;

  /* Label / eyebrow */
  --fs-label:    10px;
  --ls-label:    0.18em;
  --ls-tight:    0.03em;
  --ls-normal:   0.06em;
  --ls-wide:     0.12em;

  /* Spacing */
  --sp-1:  4px;
  --sp-2:  8px;
  --sp-3:  12px;
  --sp-4:  16px;
  --sp-5:  20px;
  --sp-6:  24px;
  --sp-8:  32px;
  --sp-10: 40px;
  --sp-12: 48px;
  --sp-16: 64px;

  /* Radius */
  --r-sm:  4px;
  --r-md:  7px;
  --r-lg:  10px;
  --r-xl:  14px;

  /* Transitions */
  --t-fast:   0.12s ease;
  --t-normal: 0.2s ease;
  --t-slow:   0.3s ease;
}

/* ── Reset ─────────────────────────────────────────────────── */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body {
  background: var(--c-bg);
  color: var(--c-text);
  font-family: var(--font-mono);
  font-size: var(--fs-base);
  line-height: 1.7;
}

/* ── Typography ────────────────────────────────────────────── */

.font-serif  { font-family: var(--font-serif); }
.font-mono   { font-family: var(--font-mono);  }
.font-light  { font-weight: 300; }
.font-normal { font-weight: 400; }

/* Display headings */
.h-display {
  font-family: var(--font-serif);
  font-size: clamp(var(--fs-3xl), 6vw, var(--fs-5xl));
  font-weight: 300;
  color: var(--c-text);
  line-height: 1.08;
  letter-spacing: -0.03em;
}
.h-display em { font-style: italic; color: var(--c-gold); }

.h-section {
  font-family: var(--font-serif);
  font-size: clamp(var(--fs-2xl), 4vw, var(--fs-4xl));
  font-weight: 300;
  color: var(--c-text);
  line-height: 1.12;
  letter-spacing: -0.02em;
}
.h-section em { font-style: italic; color: var(--c-gold); }

.h-card {
  font-family: var(--font-serif);
  font-size: var(--fs-2xl);
  font-weight: 300;
  color: var(--c-text);
  line-height: 1.2;
}

.h-small {
  font-family: var(--font-serif);
  font-size: var(--fs-xl);
  font-weight: 300;
  color: var(--c-text);
}

/* Eyebrow / label */
.eyebrow {
  font-size: var(--fs-label);
  font-family: var(--font-mono);
  color: var(--c-gold);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
}

/* Body text */
.body-lg { font-size: var(--fs-md);   color: var(--c-text-3); line-height: 1.8; letter-spacing: var(--ls-tight); }
.body-md { font-size: var(--fs-base); color: var(--c-text-3); line-height: 1.8; letter-spacing: var(--ls-tight); }
.body-sm { font-size: var(--fs-sm);   color: var(--c-text-4); line-height: 1.75; letter-spacing: var(--ls-tight); }

/* ── Form Elements ─────────────────────────────────────────── */

.field-label {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: var(--fs-label);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
  color: var(--c-text-4);
  margin-bottom: var(--sp-2);
  font-family: var(--font-mono);
  transition: color var(--t-fast);
}
.field-label.focused { color: var(--c-gold); }
.field-label .required { color: var(--c-gold); margin-left: 2px; font-size: 15px; }

.field-input {
  width: 100%;
  background: var(--c-bg-3);
  border: 1.5px solid var(--c-border);
  border-radius: var(--r-md);
  color: var(--c-text);
  font-family: var(--font-mono);
  font-size: var(--fs-base);
  padding: 13px 16px;
  outline: none;
  transition: border-color var(--t-fast), background var(--t-fast);
  caret-color: var(--c-gold);
  line-height: 1.5;
}
.field-input::placeholder { color: var(--c-text-5); }
.field-input:focus {
  border-color: var(--c-gold);
  background: #161616;
}
.field-input:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

textarea.field-input { resize: vertical; }

select.field-input {
  appearance: none;
  background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 4l4 4 4-4' stroke='%23666' stroke-width='1.4' stroke-linecap='round'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right 14px center;
  padding-right: 36px;
  cursor: pointer;
}
select.field-input option { background: #1a1a1a; color: var(--c-text); }

/* ── Buttons ───────────────────────────────────────────────── */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 24px;
  border-radius: var(--r-md);
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  letter-spacing: var(--ls-wide);
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  transition: background var(--t-fast), border-color var(--t-fast),
              color var(--t-fast), transform 0.1s;
  border: none;
  white-space: nowrap;
}
.btn:active { transform: scale(0.98); }
.btn:disabled { cursor: not-allowed; opacity: 0.45; }

.btn-primary {
  background: var(--c-gold);
  color: #0a0a0a;
}
.btn-primary:hover:not(:disabled) { background: var(--c-gold-light); }

.btn-secondary {
  background: transparent;
  border: 1.5px solid var(--c-border-2);
  color: var(--c-text-3);
}
.btn-secondary:hover:not(:disabled) { border-color: var(--c-border-3); color: var(--c-text-2); }

.btn-ghost {
  background: var(--c-gold-bg);
  border: 1px solid var(--c-gold-border);
  color: var(--c-gold);
}
.btn-ghost:hover:not(:disabled) { background: rgba(201,160,96,0.12); }

.btn-danger {
  background: transparent;
  border: 1px solid var(--c-border);
  color: var(--c-text-5);
}
.btn-danger:hover:not(:disabled) { border-color: var(--c-red); color: var(--c-red); }

.btn-sm { padding: 8px 16px; font-size: 11px; }
.btn-lg { padding: 16px 36px; font-size: var(--fs-base); }

/* Spinner */
@keyframes spin { to { transform: rotate(360deg); } }
.spinner {
  width: 16px; height: 16px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.15);
  border-top-color: currentColor;
  animation: spin 0.65s linear infinite;
  flex-shrink: 0;
}
.spinner.dark {
  border-color: rgba(10,10,10,0.2);
  border-top-color: #0a0a0a;
}

/* ── Cards ─────────────────────────────────────────────────── */

.card {
  background: var(--c-bg-2);
  border: 1px solid var(--c-border);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.card-head {
  padding: 14px 20px;
  border-bottom: 1px solid var(--c-bg-3);
  font-size: var(--fs-label);
  color: var(--c-text-5);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
  font-family: var(--font-mono);
}
.card-body { padding: 20px; }

/* ── Alerts ────────────────────────────────────────────────── */

.alert {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  border-radius: var(--r-md);
  padding: 14px 18px;
  font-size: var(--fs-sm);
  line-height: 1.65;
  font-family: var(--font-mono);
}
.alert-error {
  background: var(--c-red-bg);
  border: 1.5px solid var(--c-red-border);
  color: var(--c-red);
}
.alert-warning {
  background: var(--c-gold-bg);
  border: 1px solid var(--c-gold-border);
  color: var(--c-gold);
}
.alert-success {
  background: var(--c-green-bg);
  border: 1px solid var(--c-green-border);
  color: var(--c-green);
}

/* ── Badges / Chips ────────────────────────────────────────── */

.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 3px;
  font-size: 10px;
  letter-spacing: var(--ls-wide);
  text-transform: uppercase;
  font-family: var(--font-mono);
  white-space: nowrap;
}
.badge-gold   { background: var(--c-gold-bg);   border: 1px solid var(--c-gold-border); color: var(--c-gold);  }
.badge-green  { background: var(--c-green-bg);  border: 1px solid var(--c-green-border); color: var(--c-green); }
.badge-red    { background: var(--c-red-bg);    border: 1px solid var(--c-red-border);   color: var(--c-red);   }
.badge-muted  { background: rgba(255,255,255,0.04); border: 1px solid var(--c-border); color: var(--c-text-4); }

.pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 12px;
  border-radius: 100px;
  font-size: 11px;
  letter-spacing: 0.06em;
  font-family: var(--font-mono);
}
.pill-gold  { background: var(--c-gold-bg);  border: 1px solid var(--c-gold-border); color: var(--c-gold);  }
.pill-muted { background: rgba(255,255,255,0.04); border: 1px solid var(--c-border); color: var(--c-text-3); }

/* ── Dividers ──────────────────────────────────────────────── */

.divider { border: none; border-top: 1px solid var(--c-bg-3); }

.divider-text {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 10px;
  color: var(--c-text-5);
  letter-spacing: var(--ls-wide);
  text-transform: uppercase;
  font-family: var(--font-mono);
}
.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--c-border);
}

/* ── Section layout ────────────────────────────────────────── */

.section-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--sp-12) var(--sp-10);
}

@media (max-width: 768px) {
  .section-wrap { padding: var(--sp-8) var(--sp-6); }
}

/* ── Status dots ───────────────────────────────────────────── */

.status-dot {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--fs-label);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
  font-family: var(--font-mono);
}
.status-dot::before {
  content: '';
  width: 6px; height: 6px;
  border-radius: 50%;
  background: currentColor;
  flex-shrink: 0;
}

/* ── Animations ────────────────────────────────────────────── */

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes slideIn {
  from { opacity: 0; transform: translateX(12px); }
  to   { opacity: 1; transform: translateX(0); }
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.5; transform: scale(0.8); }
}

.anim-fade-up   { animation: fadeUp 0.6s ease both; }
.anim-fade-in   { animation: fadeIn 0.3s ease both; }
.anim-slide-in  { animation: slideIn 0.25s ease both; }

/* ── Scrollbar ─────────────────────────────────────────────── */

::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--c-border-2); border-radius: 100px; }
::-webkit-scrollbar-thumb:hover { background: var(--c-border-3); }

/* ── Focus visible ─────────────────────────────────────────── */

:focus-visible {
  outline: 2px solid var(--c-gold);
  outline-offset: 2px;
}

/* ── Selection ─────────────────────────────────────────────── */

::selection {
  background: rgba(201,160,96,0.25);
  color: var(--c-text);
}
</file>

<file path="app/homepage.css">
/* src/app/homepage.css */

/* ── HERO ── */
.hero {
  position: relative; min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; padding: 120px 40px 80px; overflow: hidden;
}
.hero-bg-image {
  position: absolute; inset: 0;
  background-size: cover; background-position: center; background-repeat: no-repeat;
}
.hero-bg-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom,
    rgba(8,8,8,0.72) 0%, rgba(8,8,8,0.55) 40%,
    rgba(8,8,8,0.72) 75%, rgba(8,8,8,0.95) 100%);
}
.hero::before {
  content: ''; position: absolute; inset: 0; z-index: 1;
  background-image:
    linear-gradient(rgba(201,160,96,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(201,160,96,0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 80%);
}
.hero::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%); width: 700px; height: 400px;
  background: radial-gradient(ellipse, rgba(201,160,96,0.06) 0%, transparent 70%);
  pointer-events: none; z-index: 1;
}
.hero-content { position: relative; z-index: 2; max-width: 900px; }

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 18px; background: rgba(201,160,96,0.08);
  border: 1px solid rgba(201,160,96,0.2); border-radius: 100px;
  font-size: var(--fs-sm); color: var(--c-gold);
  letter-spacing: var(--ls-wide); text-transform: uppercase;
  margin-bottom: 36px; animation: fadeUp 0.6s ease both;
}
.hero-eyebrow-dot {
  width: 6px; height: 6px; border-radius: 50%; background: var(--c-gold);
  animation: pulse 2s infinite;
}
.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(var(--fs-3xl), 8vw, var(--fs-5xl));
  font-weight: 300; color: var(--c-text); line-height: 1.05;
  letter-spacing: -0.03em; margin-bottom: 28px;
  animation: fadeUp 0.7s ease 0.1s both;
  text-shadow: 0 2px 20px rgba(0,0,0,0.4);
}
.hero-title em { font-style: italic; color: var(--c-gold); }
.hero-title .line2 { display: block; color: rgba(240,232,216,0.45); }

.hero-sub {
  font-size: var(--fs-md); color: rgba(255,255,255,0.45);
  line-height: 1.8; letter-spacing: var(--ls-tight);
  max-width: 520px; margin: 0 auto 52px;
  animation: fadeUp 0.7s ease 0.2s both;
}

.hero-ctas {
  display: flex; align-items: center; justify-content: center;
  gap: 14px; flex-wrap: wrap;
  animation: fadeUp 0.7s ease 0.3s both;
}
.hero-cta-primary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 16px 34px; background: var(--c-gold); border: none; border-radius: var(--r-md);
  color: #0d0d0d; font-family: var(--font-mono); font-size: var(--fs-base);
  letter-spacing: var(--ls-wide); text-transform: uppercase; text-decoration: none;
  transition: background var(--t-fast), transform 0.1s;
}
.hero-cta-primary:hover  { background: var(--c-gold-light); }
.hero-cta-primary:active { transform: scale(0.98); }
.hero-cta-secondary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 16px 28px; background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.14); border-radius: var(--r-md);
  color: var(--c-text-3); font-family: var(--font-mono); font-size: var(--fs-base);
  letter-spacing: var(--ls-wide); text-transform: uppercase; text-decoration: none;
  transition: border-color var(--t-fast), color var(--t-fast), background var(--t-fast);
  backdrop-filter: blur(4px);
}
.hero-cta-secondary:hover { border-color: rgba(255,255,255,0.28); color: var(--c-text); }

/* Stats strip */
.hero-stats {
  display: flex; align-items: center; justify-content: center;
  gap: 52px; margin-top: 72px; padding-top: 48px;
  border-top: 1px solid rgba(255,255,255,0.06);
  animation: fadeUp 0.7s ease 0.4s both;
  position: relative; z-index: 2; flex-wrap: wrap;
}
.hero-stat-divider { width: 1px; height: 32px; background: rgba(255,255,255,0.07); }
.stat-num {
  font-family: var(--font-serif); font-size: var(--fs-3xl);
  font-weight: 300; color: var(--c-text); line-height: 1;
  letter-spacing: -0.03em; margin-bottom: 6px;
  text-shadow: 0 2px 12px rgba(0,0,0,0.4);
}
.stat-label {
  font-size: var(--fs-label); color: rgba(255,255,255,0.3);
  letter-spacing: var(--ls-label); text-transform: uppercase; text-align: center;
}

/* Scroll indicator */
.hero-scroll {
  position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  animation: fadeIn 1s ease 1s both; z-index: 2;
}
.hero-scroll-text { font-size: 9px; color: var(--c-text-5); letter-spacing: var(--ls-label); text-transform: uppercase; }
.hero-scroll-line {
  width: 1px; height: 36px;
  background: linear-gradient(to bottom, var(--c-border-2), transparent);
  animation: scrollLine 1.5s ease infinite;
}
@keyframes scrollLine {
  0%   { transform: scaleY(0); transform-origin: top; opacity: 0; }
  50%  { transform: scaleY(1); opacity: 1; }
  100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
}

/* ── SECTION BASE ── */
.section { padding: 100px 40px; max-width: 1200px; margin: 0 auto; }
.section-eyebrow { font-size: var(--fs-label); color: var(--c-gold); letter-spacing: var(--ls-label); text-transform: uppercase; margin-bottom: 16px; }
.section-title {
  font-family: var(--font-serif); font-size: clamp(var(--fs-2xl), 4vw, var(--fs-3xl));
  font-weight: 300; color: var(--c-text); letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 16px;
}
.section-title em { font-style: italic; color: var(--c-gold); }
.section-sub { font-size: var(--fs-base); color: var(--c-text-4); line-height: 1.8; letter-spacing: var(--ls-tight); max-width: 520px; }

/* ── FEATURES ── */
.features-section { background: var(--c-bg-2); border-top: 1px solid var(--c-bg-3); border-bottom: 1px solid var(--c-bg-3); }
.features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 56px; }

/* ── STEPS ── */
.steps-wrap {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
  margin-top: 56px; position: relative;
}
.steps-wrap::before {
  content: ''; position: absolute; top: 28px; left: 10%; right: 10%; height: 1px;
  background: linear-gradient(to right, transparent, var(--c-border) 20%, var(--c-border) 80%, transparent);
}
.step-item { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 20px; position: relative; }
.step-num {
  width: 56px; height: 56px; border-radius: 50%;
  background: var(--c-bg-2); border: 1px solid var(--c-border);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-serif); font-size: var(--fs-xl); font-weight: 300; color: var(--c-gold);
  margin-bottom: 24px; position: relative; z-index: 1;
}
.step-title { font-family: var(--font-serif); font-size: var(--fs-lg); font-weight: 300; color: var(--c-text); margin-bottom: 10px; }
.step-desc { font-size: var(--fs-sm); color: var(--c-text-4); line-height: 1.7; letter-spacing: var(--ls-tight); }

/* ── PRICING ── */
.pricing-grid {
  display: flex; gap: 14px; margin-top: 56px; align-items: stretch; flex-wrap: wrap;
}
.pricing-grid > * { flex: 1 1 200px; min-width: 0; }

/* ── FINAL CTA ── */
.final-cta {
  position: relative; overflow: hidden; text-align: center;
  padding: 120px 40px; border-top: 1px solid var(--c-bg-3);
}
.final-cta::before {
  content: ''; position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%); width: 600px; height: 300px;
  background: radial-gradient(ellipse, rgba(201,160,96,0.08) 0%, transparent 70%);
}
.final-cta-content { position: relative; z-index: 1; max-width: 600px; margin: 0 auto; }
.final-cta-title {
  font-family: var(--font-serif); font-size: clamp(var(--fs-2xl), 5vw, var(--fs-4xl));
  font-weight: 300; color: var(--c-text); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: 20px;
}
.final-cta-title em { font-style: italic; color: var(--c-gold); }
.final-cta-sub {
  font-size: var(--fs-base); color: var(--c-text-4); letter-spacing: var(--ls-tight);
  line-height: 1.8; margin-bottom: 44px;
}
.final-cta-btns { display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; }

/* ── FOOTER ── */
.footer { border-top: 1px solid var(--c-bg-3); padding: 60px 40px 40px; max-width: 1200px; margin: 0 auto; }
.footer-top { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 52px; margin-bottom: 56px; }
.footer-brand-name {
  font-family: var(--font-serif); font-size: var(--fs-lg); font-weight: 300;
  color: var(--c-text); letter-spacing: 0.08em; text-transform: uppercase;
  margin-bottom: 14px; display: flex; align-items: center; gap: 10px;
}
.footer-brand-desc { font-size: var(--fs-sm); color: var(--c-text-5); line-height: 1.8; letter-spacing: var(--ls-tight); max-width: 240px; }
.footer-col-title { font-size: var(--fs-label); color: var(--c-text-4); letter-spacing: var(--ls-label); text-transform: uppercase; margin-bottom: 16px; }
.footer-links { display: flex; flex-direction: column; gap: 11px; }
.footer-link { font-size: var(--fs-sm); color: var(--c-text-5); text-decoration: none; letter-spacing: var(--ls-tight); transition: color var(--t-fast); }
.footer-link:hover { color: var(--c-text-3); }
.footer-bottom {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 32px; border-top: 1px solid var(--c-bg-3);
  font-size: var(--fs-xs); color: var(--c-text-5); letter-spacing: 0.06em; flex-wrap: wrap; gap: 12px;
}
.footer-bottom-links { display: flex; gap: 24px; }
.footer-bottom-link { color: var(--c-text-5); text-decoration: none; transition: color var(--t-fast); }
.footer-bottom-link:hover { color: var(--c-text-3); }

/* ── Responsive ── */
@media (max-width: 960px) {
  .features-grid { grid-template-columns: 1fr 1fr; }
  .steps-wrap    { grid-template-columns: 1fr 1fr; gap: 32px; }
  .steps-wrap::before { display: none; }
  .footer-top    { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .section       { padding: 72px 24px; }
  .features-grid { grid-template-columns: 1fr; }
  .steps-wrap    { grid-template-columns: 1fr; }
  .footer-top    { grid-template-columns: 1fr; gap: 32px; }
  .hero          { padding: 100px 24px 72px; }
  .hero-stats    { gap: 28px; }
  .hero-stat-divider { display: none; }
  .final-cta     { padding: 80px 24px; }
  .footer        { padding: 48px 24px 32px; }
}
</file>

