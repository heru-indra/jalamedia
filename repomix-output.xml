      textTransform: "uppercase" as const,
      color: s.color,
      background: s.bg,
      fontFamily: "'DM Mono', monospace",
      whiteSpace: "nowrap" as const,
    }}>
      <span style={{ width: 5, height: 5, borderRadius: "50%", background: s.dot, flexShrink: 0 }} />
      {s.label}
    </span>
  );
}

