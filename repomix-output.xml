<file path="app/api/upload/route.ts">
// src/app/api/upload/route.ts
//
// Upload gambar ke Cloudinary menggunakan UNSIGNED upload preset.
// Cara ini jauh lebih simpel — tidak perlu signature manual.
//
// ── Setup di Cloudinary Dashboard ────────────────────────────────────────────
// 1. Login ke cloudinary.com → Settings → Upload
// 2. Scroll ke "Upload presets" → klik "Add upload preset"
// 3. Signing mode: UNSIGNED
// 4. Folder: eventara  (opsional, untuk organisasi)
// 5. Salin nama preset (misal: "eventara_unsigned")
// 6. Tambahkan ke .env.local:
//      CLOUDINARY_CLOUD_NAME=your_cloud_name
//      CLOUDINARY_UPLOAD_PRESET=eventara_unsigned
//
// Tidak perlu API_KEY dan API_SECRET untuk unsigned upload.
// ─────────────────────────────────────────────────────────────────────────────

import { NextRequest, NextResponse } from "next/server";
import { auth } from "@/lib/auth";

const CLOUD_NAME    = process.env.CLOUDINARY_CLOUD_NAME!;
const UPLOAD_PRESET = process.env.CLOUDINARY_UPLOAD_PRESET!;

const FOLDER_MAP: Record<string, string> = {
  cover:   "eventara/covers",
  gallery: "eventara/gallery",
  logo:    "eventara/logos",
};

const MAX_SIZE: Record<string, number> = {
  cover:   5 * 1024 * 1024,
  gallery: 5 * 1024 * 1024,
  logo:    2 * 1024 * 1024,
};

export async function POST(request: NextRequest) {
  // ── Auth check ──────────────────────────────────────────────────────────────
  const session = await auth.api.getSession({ headers: request.headers });
  if (!session) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  }

  // ── Cek env vars ────────────────────────────────────────────────────────────
  if (!CLOUD_NAME || !UPLOAD_PRESET) {
    console.error("[Upload] Missing env vars: CLOUDINARY_CLOUD_NAME or CLOUDINARY_UPLOAD_PRESET");
    return NextResponse.json(
      { error: "Konfigurasi upload belum lengkap. Hubungi administrator." },
      { status: 500 }
    );
  }

  // ── Parse request ───────────────────────────────────────────────────────────
  let formData: FormData;
  try {
    formData = await request.formData();
  } catch {
    return NextResponse.json({ error: "Request tidak valid" }, { status: 400 });
  }

  const file = formData.get("file") as File | null;
  const type = (formData.get("type") as string | null) ?? "cover";

  if (!file || file.size === 0) {
    return NextResponse.json({ error: "File tidak ditemukan" }, { status: 400 });
  }

  // ── Validasi ────────────────────────────────────────────────────────────────
  const allowedTypes = ["image/jpeg", "image/png", "image/webp", "image/gif"];
  if (!allowedTypes.includes(file.type)) {
    return NextResponse.json(
      { error: "Format tidak didukung. Gunakan JPG, PNG, atau WebP." },
      { status: 400 }
    );
  }

  const maxSize = MAX_SIZE[type] ?? 5 * 1024 * 1024;
  if (file.size > maxSize) {
    const maxMB = Math.round(maxSize / 1024 / 1024);
    return NextResponse.json(
      { error: `Ukuran file maksimal ${maxMB} MB` },
      { status: 400 }
    );
  }

  // ── Upload ke Cloudinary (unsigned) ─────────────────────────────────────────
  const folder   = FOLDER_MAP[type] ?? "eventara/misc";
  const publicId = `${session.user.id}_${Date.now()}`;

  const upload = new FormData();
  upload.append("file",          file);
  upload.append("upload_preset", UPLOAD_PRESET);
  upload.append("folder",        folder);
  upload.append("public_id",     publicId);

  try {
    const res = await fetch(
      `https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`,
      { method: "POST", body: upload }
    );

    const data = await res.json();

    if (!res.ok) {
      // Cloudinary mengembalikan pesan error yang detail
      const msg = data?.error?.message ?? "Upload ke Cloudinary gagal";
      console.error("[Cloudinary error]", msg);
      return NextResponse.json({ error: msg }, { status: 500 });
    }

    return NextResponse.json({
      url:      data.secure_url,
      publicId: data.public_id,
      width:    data.width,
      height:   data.height,
    });

  } catch (err) {
    console.error("[Upload fetch error]", err);
    return NextResponse.json(
      { error: "Gagal terhubung ke server upload. Coba lagi." },
      { status: 500 }
    );
  }
}
</file>

<file path="app/dashboard.css">
/* src/app/(dashboard)/dashboard.css
   Shared styles for dashboard pages */

/* ── Page base ── */
.dash-page {
  min-height: 100%;
  background: var(--c-bg);
  font-family: var(--font-mono);
  padding: 44px 48px;
}

/* ── Section header ── */
.dash-label {
  font-size: var(--fs-label);
  color: var(--c-text-5);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
  margin-bottom: 6px;
}
.dash-title {
  font-family: var(--font-serif);
  font-size: clamp(var(--fs-xl), 2.5vw, var(--fs-3xl));
  font-weight: 300;
  color: var(--c-text);
  letter-spacing: -0.01em;
  margin-bottom: 0;
}
.dash-title em { font-style: italic; color: var(--c-gold); }

/* ── Stat cards ── */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 36px;
}
.stat-card {
  background: var(--c-bg-2);
  border: 1px solid var(--c-border);
  border-top: 2px solid var(--card-accent, var(--c-border));
  border-radius: var(--r-lg);
  padding: 24px 22px;
  position: relative;
}
.stat-card-icon {
  width: 36px; height: 36px;
  border-radius: 8px;
  background: var(--icon-bg, rgba(255,255,255,0.04));
  border: 1px solid var(--icon-border, var(--c-border));
  display: flex; align-items: center; justify-content: center;
  color: var(--icon-color, var(--c-text-4));
  margin-bottom: 16px;
}
.stat-number {
  font-family: var(--font-serif);
  font-size: var(--fs-4xl);
  font-weight: 300;
  color: var(--c-text);
  line-height: 1;
  margin-bottom: 4px;
  letter-spacing: -0.03em;
}
.stat-number.colored { color: var(--card-accent, var(--c-text)); }
.stat-name {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  letter-spacing: var(--ls-tight);
  margin-bottom: 4px;
}
.stat-desc { font-size: var(--fs-xs); color: var(--c-text-5); letter-spacing: var(--ls-tight); }

/* ── Events list table ── */
.ev-table {
  border: 1px solid var(--c-bg-3);
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--c-bg-2);
}
.ev-thead {
  display: grid;
  grid-template-columns: 1fr 140px 120px 100px 110px;
  padding: 10px 22px;
  border-bottom: 1px solid var(--c-bg-3);
  background: var(--c-bg);
}
.ev-th {
  font-size: 10px;
  color: var(--c-text-5);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.ev-th.right { text-align: right; }

.ev-row {
  display: grid;
  grid-template-columns: 1fr 140px 120px 100px 110px;
  padding: 0 22px;
  border-bottom: 1px solid #0d0d0d;
  align-items: center;
  min-height: 78px;
  transition: background var(--t-fast);
}
.ev-row:last-child { border-bottom: none; }
.ev-row:hover { background: rgba(255,255,255,0.015); }

.ev-cell-main { padding: 16px 0; min-width: 0; }
.ev-event-title {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  margin-bottom: 5px;
  text-decoration: none;
  display: block;
  transition: color var(--t-fast);
}
.ev-event-title:hover { color: var(--c-text); }
.ev-cat-pill {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 8px; border-radius: 100px;
  font-size: 10px; letter-spacing: 0.08em;
  background: rgba(255,255,255,0.04); border: 1px solid var(--c-border);
  color: var(--c-text-5);
}
.ev-cell { padding: 16px 0; }
.ev-cell.right { text-align: right; display: flex; align-items: center; justify-content: flex-end; }
.ev-date-text { font-size: var(--fs-xs); color: var(--c-text-5); letter-spacing: var(--ls-tight); }
.ev-price-text { font-size: var(--fs-xs); color: var(--c-text-4); }

/* ── Category filter tabs ── */
.cat-tabs { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 20px; }
.cat-tab {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 7px 14px; border-radius: 100px;
  font-size: var(--fs-xs); letter-spacing: 0.08em;
  text-decoration: none; border: 1px solid var(--c-border);
  color: var(--c-text-4); background: transparent;
  transition: all var(--t-fast); white-space: nowrap;
}
.cat-tab:hover { border-color: var(--c-border-2); color: var(--c-text-3); }
.cat-tab.active {
  border-color: var(--c-gold);
  color: var(--c-gold);
  background: var(--c-gold-bg);
}

/* ── Status tabs ── */
.status-tabs { display: flex; gap: 6px; margin-bottom: 20px; }
.status-tab {
  padding: 7px 16px; border-radius: 100px;
  font-size: var(--fs-xs); letter-spacing: 0.08em;
  text-decoration: none; border: 1px solid var(--c-border);
  color: var(--c-text-4); background: transparent;
  transition: all var(--t-fast);
}
.status-tab:hover { border-color: var(--c-border-2); color: var(--c-text-3); }
.status-tab.active {
  border-color: var(--c-border-3);
  color: var(--c-text);
  background: rgba(255,255,255,0.04);
}

/* ── Summary strip ── */
.ev-summary {
  display: flex; margin-bottom: 24px;
  border: 1px solid var(--c-bg-3); border-radius: var(--r-md); overflow: hidden;
}
.ev-s-item {
  flex: 1; padding: 18px 22px;
  background: var(--c-bg-2);
  border-right: 1px solid var(--c-bg-3);
}
.ev-s-item:last-child { border-right: none; }
.ev-s-num {
  font-family: var(--font-serif);
  font-size: var(--fs-2xl); font-weight: 300;
  color: var(--c-text); line-height: 1; margin-bottom: 4px;
}
.ev-s-lbl {
  font-size: var(--fs-label); color: var(--c-text-5);
  letter-spacing: var(--ls-label); text-transform: uppercase;
}

/* ── Limit warning ── */
.ev-limit {
  display: flex; align-items: center; gap: 10px;
  padding: 13px 18px;
  background: var(--c-gold-bg); border: 1px solid var(--c-gold-border);
  border-radius: var(--r-md); margin-bottom: 16px;
  font-size: var(--fs-sm); color: var(--c-gold); letter-spacing: var(--ls-tight);
}
.ev-limit a { color: var(--c-gold-light); text-decoration: underline; text-underline-offset: 2px; }

/* ── Empty state ── */
.ev-empty {
  padding: 72px 20px; text-align: center;
  border: 1px solid var(--c-bg-3); border-radius: var(--r-lg);
  background: var(--c-bg-2);
}
.ev-empty-icon { font-size: 40px; margin-bottom: 16px; opacity: 0.5; }
.ev-empty-title {
  font-family: var(--font-serif);
  font-size: var(--fs-xl); font-weight: 300;
  color: var(--c-text-4); margin-bottom: 8px;
}
.ev-empty-desc { font-size: var(--fs-sm); color: var(--c-text-5); letter-spacing: var(--ls-tight); line-height: 1.8; margin-bottom: 24px; }

/* ── Responsive ── */
@media (max-width: 900px) {
  .dash-page { padding: 28px 22px; }
  .stat-grid { grid-template-columns: repeat(2, 1fr); }
  .ev-thead  { grid-template-columns: 1fr 100px 100px; }
  .ev-row    { grid-template-columns: 1fr 100px 100px; }
  .hide-sm   { display: none; }
}
@media (max-width: 600px) {
  .stat-grid { grid-template-columns: 1fr 1fr; }
  .ev-thead  { grid-template-columns: 1fr 100px; }
  .ev-row    { grid-template-columns: 1fr 100px; }
  .hide-xs   { display: none; }
}
</file>

