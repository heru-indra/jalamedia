"use client";

import { useState, useRef, useCallback } from "react";
import Image from "next/image";

// ── Types ─────────────────────────────────────────────────────────────────────

export type UploadType = "cover" | "gallery" | "logo";

export interface UploadedImage {
  url:      string;
  publicId: string;
}

// ── Single image uploader (cover / logo) ─────────────────────────────────────

interface SingleImageUploadProps {
  type:          UploadType;
  label:         string;
  hint?:         string;
  defaultUrl?:   string;
  name:          string;       // hidden input name untuk form submission
  aspectRatio?:  string;       // CSS aspect-ratio, default "16/9"
  maxSizeMB?:    number;
  onChange?:     (url: string) => void;
}

export function SingleImageUpload({
  type,
  label,
  hint,
  defaultUrl,
  name,
  aspectRatio = "16/9",
  maxSizeMB   = 5,
  onChange,
}: SingleImageUploadProps) {
  const [url,       setUrl]       = useState(defaultUrl ?? "");
  const [uploading, setUploading] = useState(false);
  const [error,     setError]     = useState<string | null>(null);
  const [dragging,  setDragging]  = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);

  const upload = useCallback(async (file: File) => {
    setError(null);

    if (!file.type.startsWith("image/")) {
      setError("Hanya file gambar (JPG, PNG, WebP) yang diizinkan.");
      return;
    }
    if (file.size > maxSizeMB * 1024 * 1024) {
      setError(`Ukuran maksimal ${maxSizeMB} MB.`);
      return;
    }

    setUploading(true);
    const fd = new FormData();
    fd.append("file", file);
    fd.append("type", type);

    try {
      const res  = await fetch("/api/upload", { method: "POST", body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? "Upload gagal");
      setUrl(data.url);
      onChange?.(data.url);
    } catch (e: unknown) {
      setError(e instanceof Error ? e.message : "Upload gagal. Coba lagi.");
    } finally {
      setUploading(false);
    }
  }, [type, maxSizeMB, onChange]);

  const handleFile = (file: File | null | undefined) => {
    if (file) upload(file);
  };

  const handleDrop = useCallback((e: React.DragEvent) => {
    e.preventDefault();
    setDragging(false);
    handleFile(e.dataTransfer.files[0]);
  }, [upload]);

  const handleDragOver = (e: React.DragEvent) => { e.preventDefault(); setDragging(true);  };
  const handleDragLeave = ()                      => { setDragging(false); };

  const isLogo = type === "logo";

  return (
    <div>
      {/* Hidden input untuk form submission */}
      <input type="hidden" name={name} value={url} />

      <label style={{
        display: "flex", alignItems: "center", gap: 7,
        fontSize: 11, letterSpacing: "0.1em", textTransform: "uppercase",
        marginBottom: 8, fontFamily: "'DM Mono', monospace", color: "#555",
      }}>
        🖼 {label}
      </label>

      {/* Drop zone */}
      <div
        onClick={() => !uploading && inputRef.current?.click()}
        onDrop={handleDrop}
        onDragOver={handleDragOver}
        onDragLeave={handleDragLeave}
        style={{
          position: "relative", cursor: uploading ? "wait" : "pointer",
          borderRadius: isLogo ? "50%" : 8,
          overflow: "hidden",
          border: `1.5px dashed ${dragging ? "#c9a060" : url ? "#2a2a2a" : "#1e1e1e"}`,
          background: dragging ? "rgba(201,160,96,0.05)" : "#141414",
          transition: "border-color 0.15s, background 0.15s",
          aspectRatio: isLogo ? "1/1" : aspectRatio,
          width: isLogo ? 96 : "100%",
          display: "flex", alignItems: "center", justifyContent: "center",
        }}
      >
        {/* Preview */}
        {url && (
          <Image
            src={url}
            alt="preview"
            fill
            style={{ objectFit: "cover" }}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        )}

        {/* Overlay saat uploading */}
        {uploading && (
          <div style={{
            position: "absolute", inset: 0,
            background: "rgba(0,0,0,0.65)",
            display: "flex", flexDirection: "column",
            alignItems: "center", justifyContent: "center", gap: 10,
            zIndex: 2,
          }}>
            <div style={{
              width: 28, height: 28, borderRadius: "50%",
              border: "2.5px solid rgba(201,160,96,0.2)",
              borderTopColor: "#c9a060",
              animation: "imgUploadSpin 0.65s linear infinite",
            }} />
            <span style={{ fontSize: 11, color: "#c9a060", letterSpacing: "0.08em", fontFamily: "'DM Mono', monospace" }}>
              Mengupload...
            </span>
          </div>
        )}

        {/* Hover overlay saat sudah ada gambar */}
        {url && !uploading && (
          <div className="img-hover-overlay" style={{
            position: "absolute", inset: 0,
            background: "rgba(0,0,0,0)",
            display: "flex", alignItems: "center", justifyContent: "center",
            transition: "background 0.2s",
            zIndex: 1,
          }}>
            <span style={{
              opacity: 0, fontSize: 11, color: "#f0e8d8",
              letterSpacing: "0.1em", textTransform: "uppercase",
              fontFamily: "'DM Mono', monospace",
              background: "rgba(0,0,0,0.6)", padding: "6px 12px",
              borderRadius: 4, transition: "opacity 0.2s",
            }} className="img-change-label">
              Ganti gambar
            </span>
          </div>
        )}

        {/* Empty state */}
        {!url && !uploading && (
          <div style={{
            display: "flex", flexDirection: "column",
            alignItems: "center", gap: 10, padding: 24, zIndex: 1,
          }}>
            <div style={{
              width: 40, height: 40, borderRadius: 8,
              background: "rgba(201,160,96,0.08)",
              border: "1px solid rgba(201,160,96,0.2)",
              display: "flex", alignItems: "center", justifyContent: "center",
              fontSize: 18,
            }}>
              {isLogo ? "🏷" : "🖼"}
            </div>
            <div style={{ textAlign: "center" }}>
              <div style={{ fontSize: 12, color: "#555", letterSpacing: "0.04em", fontFamily: "'DM Mono', monospace", marginBottom: 4 }}>
                {dragging ? "Lepaskan di sini" : "Klik atau drag & drop"}
              </div>
              <div style={{ fontSize: 10, color: "#333", letterSpacing: "0.04em", fontFamily: "'DM Mono', monospace" }}>
                JPG, PNG, WebP · maks {maxSizeMB} MB
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Remove button */}
      {url && !uploading && (
        <button
          type="button"
          onClick={(e) => { e.stopPropagation(); setUrl(""); onChange?.(""); }}
          style={{
            marginTop: 8, padding: "5px 12px",
            background: "transparent", border: "1px solid #1e1e1e",
            borderRadius: 4, color: "#444",
            fontFamily: "'DM Mono', monospace", fontSize: 10,
            letterSpacing: "0.1em", textTransform: "uppercase",
            cursor: "pointer", transition: "color 0.15s, border-color 0.15s",
          }}
        >
          ✕ Hapus gambar
        </button>
      )}

      {error && (
        <div style={{
          marginTop: 8, fontSize: 11, color: "#e05a5a",
          letterSpacing: "0.04em", fontFamily: "'DM Mono', monospace",
          display: "flex", alignItems: "center", gap: 6,
        }}>
          ⚠ {error}
        </div>
      )}

      {hint && !error && (
        <div style={{ marginTop: 6, fontSize: 11, color: "#2e2e2e", letterSpacing: "0.04em", fontFamily: "'DM Mono', monospace" }}>
          {hint}
        </div>
      )}

      <input
        ref={inputRef}
        type="file"
        accept="image/jpeg,image/png,image/webp"
        style={{ display: "none" }}
        onChange={(e) => handleFile(e.target.files?.[0])}
      />
</div>
  );
}

// ── Gallery uploader (multiple images) ───────────────────────────────────────

interface GalleryUploadProps {
  name:        string;
  defaultUrls?: string[];
  maxImages?:  number;
  onChange?:   (urls: string[]) => void;
}

export function GalleryUpload({
  name,
  defaultUrls = [],
  maxImages   = 8,
  onChange,
}: GalleryUploadProps) {
  const [images,   setImages]   = useState<UploadedImage[]>(
    defaultUrls.map((url, i) => ({ url, publicId: `existing_${i}` }))
  );
  const [uploading, setUploading] = useState(false);
  const [error,     setError]     = useState<string | null>(null);
  const inputRef = useRef<HTMLInputElement>(null);

  const uploadFiles = useCallback(async (files: FileList) => {
    const remaining = maxImages - images.length;
    const toUpload  = Array.from(files).slice(0, remaining);
    if (toUpload.length === 0) {
      setError(`Maksimal ${maxImages} foto.`);
      return;
    }

    setError(null);
    setUploading(true);

    const results: UploadedImage[] = [];
    for (const file of toUpload) {
      if (!file.type.startsWith("image/")) continue;
      if (file.size > 5 * 1024 * 1024) { setError("Satu file maks 5 MB."); continue; }

      const fd = new FormData();
      fd.append("file", file);
      fd.append("type", "gallery");

      try {
        const res  = await fetch("/api/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (res.ok) results.push({ url: data.url, publicId: data.publicId });
      } catch { /* skip failed */ }
    }

    const updated = [...images, ...results];
    setImages(updated);
    onChange?.(updated.map((i) => i.url));
    setUploading(false);
  }, [images, maxImages, onChange]);

  const remove = (idx: number) => {
    const updated = images.filter((_, i) => i !== idx);
    setImages(updated);
    onChange?.(updated.map((i) => i.url));
  };

  return (
    <div>
      {/* Hidden input — simpan JSON array URL */}
      <input type="hidden" name={name} value={JSON.stringify(images.map((i) => i.url))} />

      <label style={{
        display: "flex", alignItems: "center", gap: 7,
        fontSize: 11, letterSpacing: "0.1em", textTransform: "uppercase",
        marginBottom: 8, fontFamily: "'DM Mono', monospace", color: "#555",
      }}>
        🗂 Galeri Foto
        <span style={{ color: "#333", fontSize: 9, letterSpacing: "0.1em" }}>
          ({images.length}/{maxImages})
        </span>
      </label>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: 8 }}>
        {/* Existing images */}
        {images.map((img, idx) => (
          <div key={img.publicId} style={{ position: "relative", aspectRatio: "1/1", borderRadius: 6, overflow: "hidden", background: "#1a1a1a" }}>
            <Image src={img.url} alt="" fill style={{ objectFit: "cover" }} sizes="120px" />
            <button
              type="button"
              onClick={() => remove(idx)}
              style={{
                position: "absolute", top: 5, right: 5,
                width: 22, height: 22, borderRadius: "50%",
                background: "rgba(0,0,0,0.7)", border: "none",
                color: "#f0e8d8", cursor: "pointer", fontSize: 11,
                display: "flex", alignItems: "center", justifyContent: "center",
                transition: "background 0.15s",
              }}
            >
              ✕
            </button>
          </div>
        ))}

        {/* Add button */}
        {images.length < maxImages && (
          <div
            onClick={() => !uploading && inputRef.current?.click()}
            style={{
              aspectRatio: "1/1", borderRadius: 6,
              border: "1.5px dashed #1e1e1e",
              background: "#141414", cursor: uploading ? "wait" : "pointer",
              display: "flex", flexDirection: "column",
              alignItems: "center", justifyContent: "center", gap: 4,
              transition: "border-color 0.15s",
            }}
          >
            {uploading ? (
              <div style={{
                width: 20, height: 20, borderRadius: "50%",
                border: "2px solid rgba(201,160,96,0.2)",
                borderTopColor: "#c9a060",
                animation: "imgUploadSpin 0.65s linear infinite",
              }} />
            ) : (
              <>
                <span style={{ fontSize: 18, color: "#333" }}>+</span>
                <span style={{ fontSize: 9, color: "#2a2a2a", letterSpacing: "0.1em", textTransform: "uppercase", fontFamily: "'DM Mono', monospace" }}>
                  Tambah
                </span>
              </>
            )}
          </div>
        )}
      </div>

      {error && (
        <div style={{ marginTop: 8, fontSize: 11, color: "#e05a5a", letterSpacing: "0.04em", fontFamily: "'DM Mono', monospace" }}>
          ⚠ {error}
        </div>
      )}
      <div style={{ marginTop: 6, fontSize: 11, color: "#2e2e2e", letterSpacing: "0.04em", fontFamily: "'DM Mono', monospace" }}>
        Maks {maxImages} foto · JPG, PNG, WebP · 5 MB per foto
      </div>

      <input
        ref={inputRef}
        type="file"
        accept="image/jpeg,image/png,image/webp"
        multiple
        style={{ display: "none" }}
        onChange={(e) => e.target.files && uploadFiles(e.target.files)}
      />
    </div>
  );
}
</file>

