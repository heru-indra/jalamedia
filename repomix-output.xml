interface CategoryCardsProps {
  /** URL base untuk link kategori. Default: "/jelajahi" */
  baseHref?: string;
  /** Tampilkan judul section. Default: true */
  showHeading?: boolean;
  /** Jumlah kolom grid pada desktop. Default: 3 */
  cols?: 2 | 3 | 4;
}

export async function CategoryCards({
  baseHref    = "/jelajahi",
  showHeading = true,
  cols        = 3,
}: CategoryCardsProps = {}) {
  const cats = await db
    .select()
    .from(categories)
    .orderBy(asc(categories.name));

  if (cats.length === 0) return null;

  const gridCols = { 2: "repeat(2,1fr)", 3: "repeat(3,1fr)", 4: "repeat(4,1fr)" }[cols];

  return (
    <>
<div className="cc-section">
        {showHeading && (
          <>
            <div className="cc-eyebrow">Jelajahi Kategori</div>
            <h2 className="cc-heading">
              Temukan event yang<br />
              <em>sesuai minat Anda</em>
            </h2>
            <p className="cc-sub">
              Dari workshop teknologi hingga festival kuliner —
              pilih kategori dan temukan event terbaik di sekitar Anda.
            </p>
          </>
        )}

        <div
          className={`cc-grid cc-grid-${cols}`}
          style={{ gridTemplateColumns: gridCols }}
        >
          {cats.map((cat, i) => {
            const accent = CARD_ACCENTS[i % CARD_ACCENTS.length];
            return (
              <Link
                key={cat.id}
                href={`${baseHref}?category=${cat.slug}`}
                className="cc-card"
                style={{
                  "--cc-border":       "#1e1e1e",
                  "--cc-border-hover": accent.border,
                  "--cc-bg":           accent.bg,
                  "--cc-text":         accent.text,
                } as React.CSSProperties}
              >
                <span className="cc-emoji">{cat.emoji}</span>
                <div className="cc-name">{cat.name}</div>
                <div className="cc-slug">{cat.slug}</div>
                <div className="cc-arrow">
                  Lihat event
                  <svg viewBox="0 0 13 13" fill="none" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round">
                    <line x1="1" y1="6.5" x2="12" y2="6.5" />
                    <polyline points="8 2.5 12 6.5 8 10.5" />
                  </svg>
                </div>
              </Link>
            );
          })}
        </div>
      </div>
    </>
  );
}
