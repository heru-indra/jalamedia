/* src/app/(dashboard)/events/new/new-event.css */

.np {
  min-height: 100%;
  background: var(--c-bg);
  font-family: var(--font-mono);
}

/* ── Topbar ── */
.np-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 48px;
  border-bottom: 1px solid var(--c-bg-3);
  background: var(--c-bg-2);
  position: sticky;
  top: 0;
  z-index: 10;
}
.np-topbar-left { display: flex; align-items: center; gap: 18px; }
.np-topbar-div  { width: 1px; height: 22px; background: var(--c-border); }
.np-topbar-title {
  font-family: var(--font-serif);
  font-size: var(--fs-lg);
  font-weight: 300;
  color: var(--c-text-3);
}
.np-topbar-right { display: flex; align-items: center; gap: 10px; }

.np-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--c-text-4);
  font-size: var(--fs-sm);
  letter-spacing: var(--ls-normal);
  text-decoration: none;
  transition: color var(--t-fast);
}
.np-back:hover { color: var(--c-gold); }

/* ── Body layout ── */
.np-body {
  display: grid;
  grid-template-columns: 1fr 340px;
  min-height: calc(100vh - 63px);
}
.np-main {
  padding: 48px 52px;
  border-right: 1px solid var(--c-bg-3);
}
.np-side {
  padding: 36px 28px;
  position: sticky;
  top: 63px;
  height: fit-content;
  max-height: calc(100vh - 63px);
  overflow-y: auto;
}

/* ── Headings ── */
.np-title {
  font-family: var(--font-serif);
  font-size: clamp(var(--fs-2xl), 3vw, var(--fs-3xl));
  font-weight: 300;
  color: var(--c-text);
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin-bottom: 8px;
}
.np-title em { font-style: italic; color: var(--c-gold); }
.np-subtitle {
  font-size: var(--fs-base);
  color: var(--c-text-4);
  letter-spacing: var(--ls-tight);
  margin-bottom: 44px;
}

/* ── Form sections ── */
.np-section { margin-bottom: 48px; }
.np-grid-2  { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.np-grid-1  { display: grid; gap: 24px; }

/* Section header */
.np-sec-head {
  display: flex;
  align-items: flex-start;
  gap: 18px;
  margin-bottom: 32px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--c-border);
}
.np-sec-num {
  width: 38px; height: 38px;
  border-radius: var(--r-md);
  background: var(--c-gold-bg);
  border: 1px solid var(--c-gold-border);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-serif);
  font-size: 20px; font-weight: 300;
  color: var(--c-gold);
  flex-shrink: 0;
}
.np-sec-title {
  font-family: var(--font-serif);
  font-size: var(--fs-lg);
  font-weight: 300;
  color: var(--c-text);
  margin-bottom: 4px;
}
.np-sec-desc {
  font-size: var(--fs-sm);
  color: var(--c-text-4);
  letter-spacing: var(--ls-tight);
}

/* ── Sidebar ── */
.np-side-label {
  font-size: var(--fs-label);
  color: var(--c-text-5);
  letter-spacing: var(--ls-label);
  text-transform: uppercase;
  margin-bottom: 12px;
}
.np-tip {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: var(--fs-sm);
  color: var(--c-text-5);
  letter-spacing: var(--ls-tight);
  line-height: 1.7;
  margin-bottom: 10px;
}
.np-tip-dot {
  width: 4px; height: 4px;
  border-radius: 50%;
  background: var(--c-border-2);
  margin-top: 8px;
  flex-shrink: 0;
}

/* ── Map container ── */
.np-map {
  border-radius: var(--r-md);
  overflow: hidden;
  border: 1px solid var(--c-border);
  background: var(--c-bg-3);
  margin-bottom: 24px;
}
.np-map-empty {
  height: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.np-map-empty-icon { font-size: 32px; }
.np-map-empty-text {
  font-size: var(--fs-sm);
  color: var(--c-text-5);
  letter-spacing: var(--ls-normal);
}

/* ── Google Maps inline (under location input) ── */
.np-map-inline {
  margin-top: 14px;
  border-radius: var(--r-md);
  overflow: hidden;
  border: 1px solid var(--c-border);
  background: var(--c-bg-3);
  transition: border-color var(--t-normal);
}

/* ── Upgrade prompt ── */
.np-upgrade-prompt {
  padding: 18px 20px;
  background: var(--c-gold-bg);
  border: 1px solid var(--c-gold-border);
  border-radius: var(--r-md);
  font-size: var(--fs-sm);
  color: var(--c-text-4);
  letter-spacing: var(--ls-tight);
  line-height: 1.8;
}
.np-upgrade-prompt a {
  color: var(--c-gold);
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .np-body  { grid-template-columns: 1fr 280px; }
  .np-main  { padding: 40px 36px; }
}
@media (max-width: 768px) {
  .np-body    { grid-template-columns: 1fr; }
  .np-side    { display: none; }
  .np-main    { padding: 32px 20px; border-right: none; }
  .np-topbar  { padding: 16px 20px; }
  .np-grid-2  { grid-template-columns: 1fr; }
}
