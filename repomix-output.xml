// ── Controlled Field ──────────────────────────────────────────────────────────
// Pakai value (controlled) agar isian tidak hilang saat error server action

function Field({
  icon, label, name, type = "text", value, onChange,
  required, placeholder, hint, rows, prefix,
}: {
