  featured:         boolean;
  hasAnalytics:     boolean;
  // ── Publikasi & listing ───────────────────────────────────────────────────
  visibleInListing: boolean;       // tampil di /events publik
  listingStyle:     ListingStyle;  // "standard" = kecil | "premium" = mencolok
  canUploadImages:  boolean;
  maxGalleryPhotos: number;        // 0 = tidak bisa upload galeri
