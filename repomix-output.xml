  { label: "Dashboard",   href: "/dashboard",        icon: IconGrid },
  { label: "Event Saya",  href: "/dashboard/events", icon: IconCalendar },
  { label: "Buat Event",  href: "/dashboard/events/new", icon: IconPlus },
  { label: "Analitik",    href: "/dashboard/analytics",  icon: IconBarChart },
  { label: "Pengaturan",  href: "/dashboard/settings",   icon: IconSettings },
] as const;

const TIER_LABEL: Record<string, string> = {
  free:  "Free",
  basic: "Basic",
  pro:   "Pro",
};

const TIER_COLOR: Record<string, string> = {
  free:  "#555",
  basic: "#3a6820",
  pro:   "#b48c50",
};

// ── Props ─────────────────────────────────────────────────────────────────────

interface SidebarNavProps {
  user: User;
}

// ── Component ─────────────────────────────────────────────────────────────────

export function SidebarNav({ user }: SidebarNavProps) {
  const pathname = usePathname();
  const [mobileOpen, setMobileOpen] = useState(false);
  const [signingOut, setSigningOut] = useState(false);

  const tier = user.pricingTier ?? "free";
  const initials = user.name
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();

  async function handleSignOut() {
    setSigningOut(true);
    await authClient.signOut();
    window.location.href = "/login";
  }

  const sidebarContent = (
    <>
<nav className="snav" id="sidebar-nav">
        {/* Brand */}
        <Link className="snav-brand" href="/dashboard" onClick={() => setMobileOpen(false)}>
          <div className="snav-brand-icon">
            <svg viewBox="0 0 16 16" fill="none" stroke="#b48c50" strokeWidth="1.2">
              <rect x="2" y="2" width="5" height="5" rx="1" />
              <rect x="9" y="2" width="5" height="5" rx="1" />
              <rect x="2" y="9" width="5" height="5" rx="1" />
              <circle cx="11.5" cy="11.5" r="2.5" />
            </svg>
          </div>
          <span className="snav-brand-name">Eventara</span>
        </Link>

        {/* Navigation */}
        <div className="snav-nav">
          <div className="snav-section-label">Menu</div>

          {NAV_ITEMS.map((item) => {
            const Icon = item.icon;
            const isActive =
              item.href === "/dashboard"
                ? pathname === "/dashboard"
                : pathname.startsWith(item.href);

            return (
              <Link
                key={item.href}
                href={item.href}
                className={`snav-item ${isActive ? "active" : ""}`}
                onClick={() => setMobileOpen(false)}
              >
                <span className="snav-item-icon">
                  <Icon />
                </span>
                <span className="snav-item-label">{item.label}</span>
                <span className="snav-item-arrow">
                  <IconChevron />
                </span>
              </Link>
            );
          })}

          <div className="snav-divider" />

          <div className="snav-section-label">Akun</div>

          <Link
            href="/dashboard/settings"
            className={`snav-item ${pathname === "/dashboard/settings" ? "active" : ""}`}
            onClick={() => setMobileOpen(false)}
          >
            <span className="snav-item-icon"><IconSettings /></span>
            <span className="snav-item-label">Pengaturan</span>
            <span className="snav-item-arrow"><IconChevron /></span>
          </Link>
        </div>

        {/* Upgrade banner — only shown for free tier */}
        {tier === "free" && (
          <div className="snav-upgrade">
            <div className="snav-upgrade-title">Upgrade ke Basic</div>
            <div className="snav-upgrade-desc">
              Publish event dan jangkau audiens lebih luas.
            </div>
            <Link href="/dashboard/upgrade" className="snav-upgrade-btn">
              Lihat paket →
            </Link>
          </div>
        )}

        {/* User footer */}
        <div className="snav-user">
          <div className="snav-avatar">{initials}</div>
          <div className="snav-user-info">
            <div className="snav-user-name" title={user.name}>
              {user.name}
            </div>
            <div
              className="snav-user-tier"
              style={{ color: TIER_COLOR[tier] }}
            >
              {TIER_LABEL[tier]}
            </div>
          </div>
          <button
            className="snav-signout"
            onClick={handleSignOut}
            disabled={signingOut}
            title="Keluar"
            aria-label="Keluar"
          >
            <IconLogOut />
          </button>
        </div>
      </nav>
    </>
  );

  return (
    <>
      {/* Mobile toggle button */}
      <button
        className="snav-mobile-toggle"
        onClick={() => setMobileOpen((v) => !v)}
        aria-label={mobileOpen ? "Tutup menu" : "Buka menu"}
      >
        {mobileOpen ? <IconX /> : <IconMenu />}
      </button>

      {/* Overlay for mobile */}
      <div
        className={`snav-mobile-overlay ${mobileOpen ? "open" : ""}`}
        onClick={() => setMobileOpen(false)}
      />

      {/* Sidebar — add mobile-open class when open */}
      <div style={{ display: "contents" }}>
{sidebarContent}
      </div>
    </>
  );
}
</file>

