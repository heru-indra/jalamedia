              {/* Galeri & Logo — hanya tier berbayar */}
              {maxGalleryPhotos > 0 ? (
                <>
                  <GalleryUpload
                    name="galleryImages"
                    defaultUrls={
                      event.galleryImages
                        ? (() => { try { return JSON.parse(event.galleryImages); } catch { return []; } })()
                        : []
                    }
                    maxImages={maxGalleryPhotos}
                  />
                  <div style={{ display: "flex", alignItems: "flex-start", gap: 16 }}>
                    <SingleImageUpload
                      type="logo"
                      name="organizerLogo"
                      label="Logo Organizer"
                      hint="Maks 2 MB"
                      aspectRatio="1/1"
                      maxSizeMB={2}
                    />
                  </div>
                </>
              ) : (
                <div style={{
                  padding: "14px 16px",
                  background: "rgba(201,160,96,0.04)", border: "1px solid rgba(201,160,96,0.1)",
                  borderRadius: 6, fontSize: 10, color: "#444",
