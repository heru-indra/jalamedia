// ── Status badge ──────────────────────────────────────────────────────────────

function StatusBadge({ status }: { status: string }) {
  const cfg: Record<string, { label: string; color: string; bg: string; dot: string }> = {
    draft:     { label: "Draft",      color: "#555",    bg: "rgba(255,255,255,0.04)", dot: "#333" },
    published: { label: "Aktif",      color: "#5a8830", bg: "rgba(90,136,48,0.1)",   dot: "#5a8830" },
    cancelled: { label: "Dibatalkan", color: "#8b2020", bg: "rgba(139,32,32,0.1)",   dot: "#8b2020" },
  };
  const s = cfg[status] ?? cfg.draft;
  return (
    <span style={{
      display: "inline-flex",
      alignItems: "center",
      gap: "5px",
      padding: "3px 9px",
      borderRadius: "3px",
      fontSize: "9px",
