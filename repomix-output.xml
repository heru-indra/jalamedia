<file path="app/(dashboard)/events/page.tsx">
import Link from "next/link";
import "@/app/dashboard.css";
import { requireAuth } from "@/lib/auth-helper";
import { db } from "@/db";
import { events, categories } from "@/db/schema";
import { eq, desc, and } from "drizzle-orm";
import { TIER_LIMITS } from "@/lib/tiers";
import { EventActions } from "./event-actions";


// ── Helpers ───────────────────────────────────────────────────────────────────

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "short", year: "numeric" }).format(date);
}

function formatPrice(price: string | null) {
  const n = Number(price);
  if (!n) return "Gratis";
  return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 }).format(n);
}

// ── Icons ─────────────────────────────────────────────────────────────────────

function IconPlus() {
  return <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round"><line x1="7" y1="1" x2="7" y2="13"/><line x1="1" y1="7" x2="13" y2="7"/></svg>;
}
function IconMapPin() {
  return <svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round"><path d="M5.5 1a3 3 0 0 1 3 3C8.5 7 5.5 10 5.5 10S2.5 7 2.5 4a3 3 0 0 1 3-3z"/><circle cx="5.5" cy="4" r="1"/></svg>;
}
function IconClock() {
  return <svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round"><circle cx="5.5" cy="5.5" r="4"/><polyline points="5.5 3 5.5 5.5 7 6.5"/></svg>;
}
function IconTicket() {
  return <svg width="11" height="11" viewBox="0 0 11 11" fill="none" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round"><path d="M1 4.5V2.5a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v2a1.5 1.5 0 0 0 0 3v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-2a1.5 1.5 0 0 0 0-3z"/></svg>;
}

function StatusBadge({ status }: { status: string }) {
  const cfg: Record<string, { label: string; color: string; bg: string; border: string }> = {
    draft:     { label: "Draft",  color: "#666",    bg: "rgba(255,255,255,0.04)", border: "#1e1e1e" },
    published: { label: "Aktif",  color: "#6aaa38", bg: "rgba(106,170,56,0.1)",  border: "rgba(106,170,56,0.25)" },
    cancelled: { label: "Batal",  color: "#e05a5a", bg: "rgba(224,90,90,0.1)",   border: "rgba(224,90,90,0.25)" },
  };
  const s = cfg[status] ?? cfg.draft;
  return (
    <span style={{
      display: "inline-flex", alignItems: "center", gap: 5,
      padding: "3px 9px", borderRadius: 3, border: `1px solid ${s.border}`,
      fontSize: 9, letterSpacing: "0.1em", textTransform: "uppercase",
      color: s.color, background: s.bg, fontFamily: "'DM Mono', monospace", whiteSpace: "nowrap",
    }}>
      <span style={{ width: 5, height: 5, borderRadius: "50%", background: s.color, display: "inline-block" }} />
      {s.label}
    </span>
  );
}

// ── Page ──────────────────────────────────────────────────────────────────────

interface Props {
  searchParams: Promise<{ category?: string; status?: string }>;
}

export default async function EventsPage({ searchParams }: Props) {
  const session = await requireAuth();
  const userId  = session.user.id;
  const tier    = (session.user.pricingTier ?? "free") as "free" | "basic" | "pro";
  const limits  = TIER_LIMITS[tier];

  const { category: categorySlug, status: statusFilter } = await searchParams;

  // Fetch kategori untuk tab filter
  const allCategories = await db.select().from(categories).orderBy(categories.name);

  // Cari categoryId dari slug jika ada filter
  const activeCategory = categorySlug
    ? allCategories.find((c) => c.slug === categorySlug)
    : null;

  // Fetch events dengan optional filter
  const conditions = [eq(events.userId, userId)];
  if (activeCategory) conditions.push(eq(events.categoryId, activeCategory.id));
  if (statusFilter === "published") conditions.push(eq(events.status, "published"));
  if (statusFilter === "draft")     conditions.push(eq(events.status, "draft"));

  // Join events dengan categories
  const allEvents = await db
    .select({
      event:    events,
      category: categories,
    })
    .from(events)
    .leftJoin(categories, eq(events.categoryId, categories.id))
    .where(and(...conditions))
    .orderBy(desc(events.createdAt));

  const totalCount     = allEvents.length;
  const publishedCount = allEvents.filter((e) => e.event.status === "published").length;
  const draftCount     = allEvents.filter((e) => e.event.status === "draft").length;
  const atLimit        = limits.maxEvents < 999 && totalCount >= limits.maxEvents;

  return (
    <>
<div className="ev-page">
        {/* Header */}
        <div className="ev-header">
          <div>
            <div className="ev-label">Manajemen</div>
            <h1 className="ev-title">Event <em>Saya</em></h1>
          </div>
          <Link
            href="/dashboard/events/new"
            className={`ev-new-btn ${atLimit ? "disabled" : ""}`}
            aria-disabled={atLimit}
          >
            <IconPlus /> Buat Event
          </Link>
        </div>

        {/* Limit warning */}
        {atLimit && (
          <div className="ev-limit">
            ⚠ Batas {limits.maxEvents} event tercapai.{" "}
            <Link href="/dashboard/upgrade">Upgrade paket</Link> untuk membuat lebih banyak.
          </div>
        )}

        {/* Summary */}
        <div className="ev-summary">
          <div className="ev-s-item">
            <div className="ev-s-num">{totalCount}</div>
            <div className="ev-s-lbl">Total Event</div>
          </div>
          <div className="ev-s-item">
            <div className="ev-s-num" style={{ color: "#6aaa38" }}>{publishedCount}</div>
            <div className="ev-s-lbl">Dipublikasi</div>
          </div>
          <div className="ev-s-item">
            <div className="ev-s-num" style={{ color: "#444" }}>{draftCount}</div>
            <div className="ev-s-lbl">Draft</div>
          </div>
          <div className="ev-s-item">
            <div className="ev-s-num" style={{ color: "#c9a060" }}>
              {tier === "free" ? "Free" : tier === "basic" ? "Basic" : "Pro"}
            </div>
            <div className="ev-s-lbl">Paket Aktif</div>
          </div>
        </div>

        {/* ── Category filter tabs ── */}
        <div className="cat-tabs">
          <Link
            href="/dashboard/events"
            className={`cat-tab ${!categorySlug ? "active" : ""}`}
          >
            Semua
          </Link>
          {allCategories.map((cat) => (
            <Link
              key={cat.slug}
              href={`/dashboard/events?category=${cat.slug}${statusFilter ? `&status=${statusFilter}` : ""}`}
              className={`cat-tab ${categorySlug === cat.slug ? "active" : ""}`}
            >
              {cat.emoji} {cat.name}
            </Link>
          ))}
        </div>

        {/* Status filter */}
        <div className="status-tabs">
          <Link
            href={`/dashboard/events${categorySlug ? `?category=${categorySlug}` : ""}`}
            className={`status-tab ${!statusFilter ? "active" : ""}`}
          >
            Semua status
          </Link>
          <Link
            href={`/dashboard/events?status=published${categorySlug ? `&category=${categorySlug}` : ""}`}
            className={`status-tab ${statusFilter === "published" ? "active" : ""}`}
          >
            ● Aktif
          </Link>
          <Link
            href={`/dashboard/events?status=draft${categorySlug ? `&category=${categorySlug}` : ""}`}
            className={`status-tab ${statusFilter === "draft" ? "active" : ""}`}
          >
            ○ Draft
          </Link>
        </div>

        {/* Table / Empty */}
        {allEvents.length === 0 ? (
          <div className="ev-empty">
            <div className="ev-empty-title">
              {categorySlug ? `Belum ada event kategori "${activeCategory?.name}"` : "Belum ada event"}
            </div>
            <div className="ev-empty-desc">
              {categorySlug
                ? "Coba pilih kategori lain atau buat event baru di kategori ini."
                : "Buat event pertama Anda dan mulai bagikan ke audiens."
              }
            </div>
            <Link href="/dashboard/events/new" className="ev-empty-btn">
              <IconPlus /> Buat event
            </Link>
          </div>
        ) : (
          <div className="ev-table">
            <div className="ev-thead">
              <div className="ev-th">Event</div>
              <div className="ev-th hide-sm">Tanggal</div>
              <div className="ev-th hide-xs">Harga</div>
              <div className="ev-th">Status</div>
              <div className="ev-th r">Aksi</div>
            </div>

            {allEvents.map(({ event, category }) => (
              <div key={event.id} className="ev-row">
                <div className="ev-cell-main">
                  <Link href={`/dashboard/events/${event.id}`} className="ev-event-title">
                    {event.title}
                  </Link>
                  <div className="ev-meta">
                    <span className="ev-chip"><IconMapPin />{event.location.length > 24 ? event.location.slice(0, 24) + "…" : event.location}</span>
                    {category && (
                      <span className="ev-cat-pill">
                        {category.emoji} {category.name}
                      </span>
                    )}
                  </div>
                </div>

                <div className="ev-cell hide-sm">
                  <div className="ev-date-text">
                    <span style={{ display: "flex", alignItems: "center", gap: 4 }}>
                      <IconClock /> {formatDate(new Date(event.startDate))}
                    </span>
                  </div>
                </div>

                <div className="ev-cell hide-xs">
                  <span className={`ev-price-text ${!Number(event.ticketPrice) ? "free" : ""}`}>
                    <span style={{ display: "flex", alignItems: "center", gap: 4 }}>
                      <IconTicket /> {formatPrice(event.ticketPrice)}
                    </span>
                  </span>
                </div>

                <div className="ev-cell">
                  <StatusBadge status={event.status ?? "draft"} />
                </div>

                <div className="ev-cell r">
                  <EventActions
                    eventId={event.id}
                    status={event.status ?? "draft"}
                    canPublish={limits.canPublish}
                  />
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </>
  );
}
</file>

