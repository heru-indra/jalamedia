          .ev-row         { grid-template-columns: 1fr 90px; }
          .ev-th.hide-xs, .ev-cell.hide-xs { display: none; }
        }
      `}</style>

      <div className="ev-page">
        {/* ── Header ── */}
        <div className="ev-header">
          <div>
            <div className="ev-title-label">Manajemen</div>
            <h1 className="ev-title">
              Event <em>Saya</em>
            </h1>
          </div>
          <div className="ev-header-right">
            <Link
              href="/dashboard/events/new"
              className={`ev-new-btn ${atLimit ? "disabled" : ""}`}
