export type PricingTier    = "free" | "basic" | "pro" | "commission";
export type ListingStyle   = "standard" | "premium";

export interface TierConfig {
  id:               PricingTier;
  label:            string;
  price:            string;
  priceMonthly:     number;
  period:           string;
  desc:             string;
  maxEvents:        number;        // 999 = tidak terbatas
