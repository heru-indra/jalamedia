              dimulai di sini
            </h1>
            <p className="hero-sub">
              Platform event organizer<br />
              profesional untuk semua skala
            </p>
          </div>

          <div className="left-footer">
            <div>
              <div className="stat-num">12K+</div>
              <div className="stat-label">Event dibuat</div>
            </div>
            <div>
              <div className="stat-num">98%</div>
              <div className="stat-label">Kepuasan</div>
            </div>
            <div>
              <div className="stat-num">3</div>
              <div className="stat-label">Tier harga</div>
            </div>
          </div>

          <div className="deco-line" />
        </div>

        {/* ── Right ── */}
        <div className="login-right">
          <div className="login-card">
            <h2 className="auth-heading">Masuk</h2>
            <p className="auth-subheading">Selamat datang kembali</p>

            {/* ── Session timeout banner ── */}
            {isTimeout && (
              <div className="auth-banner timeout" role="alert">
                <span className="auth-banner-icon">
                  <IconClock />
                </span>
                <span>
                  <strong>Sesi Anda berakhir</strong> karena tidak aktif.<br />
                  Silakan masuk kembali untuk melanjutkan.
                </span>
