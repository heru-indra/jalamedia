<file path="app/navbar.css">
/* src/components/navbar.css */

.nav-root {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  transition: background var(--t-slow), border-color var(--t-slow), backdrop-filter var(--t-slow);
  font-family: var(--font-mono);
}
.nav-root.scrolled {
  background: rgba(10,10,10,0.93);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--c-border);
}
.nav-root.top {
  background: transparent;
  border-bottom: 1px solid transparent;
}

.nav-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 44px;
  height: 70px;
  display: flex;
  align-items: center;
}

/* Brand */
.nav-brand {
  display: flex; align-items: center; gap: 11px;
  text-decoration: none; margin-right: auto;
}
.nav-brand-icon {
  width: 36px; height: 36px;
  border: 1px solid rgba(201,160,96,0.4); border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  transition: border-color var(--t-fast);
}
.nav-brand:hover .nav-brand-icon { border-color: var(--c-gold); }
.nav-brand-name {
  font-family: var(--font-serif);
  font-size: var(--fs-lg); font-weight: 300;
  color: var(--c-text); letter-spacing: 0.08em; text-transform: uppercase;
}

/* Desktop links */
.nav-links { display: flex; align-items: center; gap: 2px; margin: 0 36px; }
.nav-link {
  padding: 9px 15px;
  font-size: var(--fs-sm); letter-spacing: var(--ls-wide); text-transform: uppercase;
  color: var(--c-text-4); text-decoration: none; border-radius: var(--r-sm);
  transition: color var(--t-fast), background var(--t-fast);
  position: relative;
}
.nav-link:hover { color: var(--c-text-2); background: rgba(255,255,255,0.04); }
.nav-link.active { color: var(--c-text); }
.nav-link.active::after {
  content: ''; position: absolute;
  bottom: 2px; left: 50%; transform: translateX(-50%);
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--c-gold);
}

/* Desktop CTAs */
.nav-ctas { display: flex; align-items: center; gap: 8px; }
.nav-btn-ghost {
  padding: 9px 20px; background: transparent;
  border: 1px solid var(--c-border); border-radius: var(--r-sm);
  color: var(--c-text-3); font-family: var(--font-mono);
  font-size: var(--fs-sm); letter-spacing: var(--ls-wide); text-transform: uppercase;
  text-decoration: none; transition: border-color var(--t-fast), color var(--t-fast);
}
.nav-btn-ghost:hover { border-color: var(--c-border-3); color: var(--c-text-2); }
.nav-btn-solid {
  padding: 9px 22px; background: var(--c-gold); border: none; border-radius: var(--r-sm);
  color: #0d0d0d; font-family: var(--font-mono);
  font-size: var(--fs-sm); letter-spacing: var(--ls-wide); text-transform: uppercase;
  text-decoration: none; transition: background var(--t-fast);
}
.nav-btn-solid:hover { background: var(--c-gold-light); }
.nav-btn-dash {
  padding: 9px 20px;
  background: var(--c-gold-bg); border: 1px solid var(--c-gold-border);
  border-radius: var(--r-sm); color: var(--c-gold); font-family: var(--font-mono);
  font-size: var(--fs-sm); letter-spacing: var(--ls-wide); text-transform: uppercase;
  text-decoration: none; transition: background var(--t-fast), border-color var(--t-fast);
}
.nav-btn-dash:hover { background: rgba(201,160,96,0.14); border-color: rgba(201,160,96,0.4); }

/* Mobile toggle */
.nav-mobile-toggle {
  display: none; background: transparent;
  border: 1px solid var(--c-border); border-radius: var(--r-sm);
  width: 38px; height: 38px; align-items: center; justify-content: center;
  cursor: pointer; color: var(--c-text-3);
  transition: color var(--t-fast), border-color var(--t-fast);
  margin-left: 14px;
}
.nav-mobile-toggle:hover { color: var(--c-text); border-color: var(--c-border-2); }

/* Mobile overlay */
.nav-mobile-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.6); z-index: 99;
  backdrop-filter: blur(4px); animation: fadeIn 0.2s ease;
}
.nav-mobile-overlay.open { display: block; }

/* Mobile panel */
.nav-mobile-panel {
  position: fixed; top: 0; right: 0;
  width: min(320px, 85vw); height: 100vh;
  background: var(--c-bg-2); border-left: 1px solid var(--c-border);
  z-index: 100; display: flex; flex-direction: column; padding: 26px;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
}
.nav-mobile-panel.open { transform: translateX(0); }

.nav-mobile-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 40px;
}
.nav-mobile-close {
  background: transparent; border: none; color: var(--c-text-4);
  cursor: pointer; display: flex; align-items: center; padding: 4px;
  transition: color var(--t-fast);
}
.nav-mobile-close:hover { color: var(--c-text); }

.nav-mobile-links { display: flex; flex-direction: column; gap: 2px; flex: 1; }
.nav-mobile-link {
  display: flex; align-items: center; padding: 16px 14px;
  font-size: var(--fs-base); letter-spacing: var(--ls-wide); text-transform: uppercase;
  color: var(--c-text-4); text-decoration: none; border-radius: 7px;
  transition: color var(--t-fast), background var(--t-fast);
  border-bottom: 1px solid var(--c-bg-3);
}
.nav-mobile-link:hover { color: var(--c-text); background: rgba(255,255,255,0.03); }
.nav-mobile-link.active { color: var(--c-gold); }

.nav-mobile-divider { height: 1px; background: var(--c-bg-3); margin: 22px 0; }
.nav-mobile-ctas { display: flex; flex-direction: column; gap: 10px; }
.nav-mobile-btn {
  display: block; padding: 15px 22px; border-radius: 7px;
  font-family: var(--font-mono); font-size: var(--fs-base);
  letter-spacing: var(--ls-wide); text-transform: uppercase;
  text-align: center; text-decoration: none; transition: all var(--t-fast);
}
.nav-mobile-btn.ghost {
  background: transparent; border: 1px solid var(--c-border-2); color: var(--c-text-3);
}
.nav-mobile-btn.ghost:hover { border-color: var(--c-border-3); color: var(--c-text-2); }
.nav-mobile-btn.solid { background: var(--c-gold); border: none; color: #0d0d0d; }
.nav-mobile-btn.solid:hover { background: var(--c-gold-light); }
.nav-mobile-btn.dash {
  background: var(--c-gold-bg); border: 1px solid var(--c-gold-border); color: var(--c-gold);
}
.nav-mobile-btn.dash:hover { background: rgba(201,160,96,0.15); }

@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav-ctas  { display: none; }
  .nav-mobile-toggle { display: flex; }
  .nav-inner { padding: 0 22px; }
}
</file>

