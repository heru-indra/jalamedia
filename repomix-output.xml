              title={atLimit ? `Batas ${limits.maxEvents} event tercapai` : undefined}
            >
              <IconPlus />
              Buat Event
            </Link>
          </div>
        </div>

        {/* ── Limit warning ── */}
        {atLimit && (
          <div className="ev-limit-warn">
            <span>⚠</span>
            <span>
