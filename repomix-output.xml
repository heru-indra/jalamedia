"use client";

import "../auth.css";

import { useState } from "react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { authClient } from "@/lib/auth-client";

type Tier = "free" | "basic" | "pro" | "commission";

const TIERS: { id: Tier; label: string; price: string; perks: string[] }[] = [
  { id: "free",       label: "Free",   price: "Rp 0",    perks: ["3 event draft", "Akses dashboard"] },
  { id: "basic",      label: "Basic",  price: "Rp 99K",  perks: ["20 event aktif", "Publish & promote"] },
  { id: "pro",        label: "Pro",    price: "Rp 299K", perks: ["Event tak terbatas", "Featured homepage"] },
  { id: "commission", label: "Komisi", price: "5%",      perks: ["Event tak terbatas", "Bayar per tiket terjual"] },
];

function getStrength(pw: string) {
  if (!pw.length) return 0;
  let s = 0;
  if (pw.length >= 8)           s++;
  if (/[A-Z]/.test(pw))         s++;
  if (/[0-9]/.test(pw))         s++;
  if (/[^A-Za-z0-9]/.test(pw))  s++;
  return s;
}

function GoogleIcon() {
  return (
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
      <path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/>
      <path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z" fill="#34A853"/>
      <path d="M3.964 10.706A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.706V4.962H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.038l3.007-2.332z" fill="#FBBC05"/>
      <path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.962L3.964 6.294C4.672 4.169 6.656 3.58 9 3.58z" fill="#EA4335"/>
    </svg>
  );
}

export default function RegisterPage() {
  const router = useRouter();
  const [isLoading,      setIsLoading]      = useState(false);
  const [isGoogleLoading, setGoogleLoading] = useState(false);
  const [error,          setError]          = useState<string | null>(null);
  const [focused,        setFocused]        = useState<string | null>(null);
  const [selectedTier,   setSelectedTier]   = useState<Tier>("free");
  const [step,           setStep]           = useState<1 | 2>(1);
  const [name,           setName]           = useState("");
  const [email,          setEmail]          = useState("");
  const [password,       setPassword]       = useState("");

  const busy     = isLoading || isGoogleLoading;
  const strength = getStrength(password);
  const strengthColor = strength <= 1 ? "#8b2020" : strength <= 2 ? "#c9a060" : "#5a8830";
  const strengthLabel = ["", "Lemah", "Cukup", "Kuat", "Sangat kuat"][strength];

  async function handleGoogleSignIn() {
    setError(null);
    setGoogleLoading(true);
    await authClient.signIn.social({
      provider:    "google",
      callbackURL: "/dashboard",
    });
  }

  function handleNextStep(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setError(null);
    if (!name.trim())  { setError("Nama tidak boleh kosong."); return; }
    if (!email.trim()) { setError("Email tidak boleh kosong."); return; }
    setStep(2);
  }

  async function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    setError(null);
    const fd      = new FormData(e.currentTarget);
    const confirm = fd.get("confirm") as string;

    if (password !== confirm) { setError("Password dan konfirmasi tidak cocok."); return; }
    if (password.length < 8)  { setError("Password minimal 8 karakter."); return; }

    setIsLoading(true);
    const result = await authClient.signUp.email({ name, email, password });
    if (result.error) {
      setError(result.error.message ?? "Pendaftaran gagal. Coba lagi.");
      setIsLoading(false);
    } else {
      router.push("/dashboard");
      router.refresh();
    }
  }

  return (
    <>
<div className="reg-root">
        {/* Left */}
        <div className="reg-left">
          <div className="brand-mark">
            <div className="brand-icon">
              <svg viewBox="0 0 16 16" fill="none" stroke="#c9a060" strokeWidth="1.2">
                <rect x="2" y="2" width="5" height="5" rx="1" />
                <rect x="9" y="2" width="5" height="5" rx="1" />
                <rect x="2" y="9" width="5" height="5" rx="1" />
                <circle cx="11.5" cy="11.5" r="2.5" />
              </svg>
            </div>
            <span className="brand-name">Eventara</span>
          </div>

          <div className="tier-section">
            <h2 className="tier-title">Pilih paket Anda</h2>
            <p className="tier-subtitle">Bisa diubah kapan saja</p>
            <div className="tier-cards-list">
              {TIERS.map((t) => (
                <div
                  key={t.id}
                  className={`tier-card ${selectedTier === t.id ? "selected" : ""}`}
                  onClick={() => setSelectedTier(t.id)}
                  role="radio"
                  aria-checked={selectedTier === t.id}
                  tabIndex={0}
                  onKeyDown={(e) => e.key === "Enter" && setSelectedTier(t.id)}
                >
                  <div className="tier-card-left">
                    <div className="tier-radio" />
                    <div>
                      <div className="tier-card-name">{t.label}</div>
                      <div className="tier-card-perks">{t.perks.join(" · ")}</div>
                    </div>
                  </div>
                  <div className="tier-card-price">{t.price}</div>
                </div>
              ))}
            </div>
          </div>

          <p className="left-footer-note">
            Semua paket termasuk akses penuh<br />
            ke fitur dasar platform Eventara.
          </p>
          <div className="deco-line" />
        </div>

        {/* Right */}
        <div className="reg-right">
          <div className="reg-card">
            {/* Step 1 */}
            {step === 1 && (
              <div className="form-step">
                <div className="step-indicator">
                  <div className="step-dot active" />
                  <div className="step-dot inactive" />
                </div>
                <h2 className="auth-heading">Buat akun</h2>
                <p className="auth-subheading">Langkah 1 — identitas</p>

                {/* Google */}
                <button
                  type="button"
                  className="btn-google"
                  onClick={handleGoogleSignIn}
                  disabled={busy}
                >
                  {isGoogleLoading ? (
                    <><span className="spinner" style={{ borderTopColor: "#888" }} /> Menghubungkan...</>
                  ) : (
                    <><GoogleIcon /> Daftar dengan Google</>
                  )}
                </button>

                <div className="auth-divider">atau daftar dengan email</div>

                {error && <div className="auth-error" role="alert">{error}</div>}

                <form onSubmit={handleNextStep} noValidate>
                  <div className={`field ${focused === "name" ? "is-focused" : ""}`}>
                    <label className="field-label" htmlFor="reg-name">Nama lengkap</label>
                    <input
                      id="reg-name" name="name" type="text"
                      className="field-input" placeholder="Budi Santoso"
                      autoComplete="name" required
                      value={name} onChange={(e) => setName(e.target.value)}
                      onFocus={() => setFocused("name")}
                      onBlur={() => setFocused(null)}
                    />
                    <span className="field-underline" />
                  </div>

                  <div className={`field ${focused === "email" ? "is-focused" : ""}`}>
                    <label className="field-label" htmlFor="reg-email">Email</label>
                    <input
                      id="reg-email" name="email" type="email"
                      className="field-input" placeholder="nama@domain.com"
                      autoComplete="email" required
                      value={email} onChange={(e) => setEmail(e.target.value)}
                      onFocus={() => setFocused("email")}
                      onBlur={() => setFocused(null)}
                    />
                    <span className="field-underline" />
                  </div>

                  <button type="submit" className="btn-submit" style={{ width: "100%", marginTop: 8 }}>
                    Lanjut →
                  </button>
                </form>

                <div className="auth-footer">
                  Sudah punya akun? <Link href="/login">Masuk</Link>
                </div>
              </div>
            )}

            {/* Step 2 */}
            {step === 2 && (
              <form className="form-step" onSubmit={handleSubmit} noValidate>
                <div className="step-indicator">
                  <div className="step-dot done" />
                  <div className="step-dot active" />
                </div>
                <h2 className="auth-heading">Buat akun</h2>
                <p className="auth-subheading">Langkah 2 — keamanan</p>

                {error && <div className="auth-error" role="alert">{error}</div>}

                <div className={`field ${focused === "password" ? "is-focused" : ""}`}>
                  <label className="field-label" htmlFor="reg-password">Password</label>
                  <input
                    id="reg-password" name="password" type="password"
                    className="field-input" placeholder="Minimal 8 karakter"
                    autoComplete="new-password" required
                    value={password} onChange={(e) => setPassword(e.target.value)}
                    onFocus={() => setFocused("password")}
                    onBlur={() => setFocused(null)}
                  />
                  <span className="field-underline" />
                  {password.length > 0 && (
                    <>
                      <div className="pw-bars">
                        {[1,2,3,4].map((i) => (
                          <div key={i} className="pw-bar" style={{ background: i <= strength ? strengthColor : "#1e1e1e" }} />
                        ))}
                      </div>
                      <div className="pw-strength-label" style={{ color: strengthColor }}>{strengthLabel}</div>
                    </>
                  )}
                </div>

                <div className={`field ${focused === "confirm" ? "is-focused" : ""}`}>
                  <label className="field-label" htmlFor="reg-confirm">Konfirmasi password</label>
                  <input
                    id="reg-confirm" name="confirm" type="password"
                    className="field-input" placeholder="Ulangi password"
                    autoComplete="new-password" required
                    onFocus={() => setFocused("confirm")}
                    onBlur={() => setFocused(null)}
                  />
                  <span className="field-underline" />
                </div>

                <div className="btn-row">
                  <button type="button" className="btn-back" onClick={() => { setError(null); setStep(1); }} disabled={busy}>
                    ← Kembali
                  </button>
                  <button type="submit" className="btn-submit" disabled={busy}>
                    {isLoading ? <><span className="spinner" />Mendaftar...</> : "Daftar"}
                  </button>
                </div>

                <div className="auth-footer">
                  Sudah punya akun? <Link href="/login">Masuk</Link>
                </div>
              </form>
            )}
          </div>
        </div>
      </div>
    </>
  );
}
