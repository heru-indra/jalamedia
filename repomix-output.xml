/* src/app/jelajahi/jelajahi.css */

/* ── Hero ── */
.jel-hero {
  padding: 120px 40px 64px;
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}
.jel-title {
  font-family: var(--font-serif);
  font-size: clamp(var(--fs-2xl), 5vw, var(--fs-4xl));
  font-weight: 300;
  color: var(--c-text);
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin-bottom: 16px;
}
.jel-title em { font-style: italic; color: var(--c-gold); }
.jel-sub {
  font-size: var(--fs-base);
  color: var(--c-text-4);
  line-height: 1.8;
  letter-spacing: var(--ls-tight);
  max-width: 480px;
  margin: 0 auto;
}

/* ── Category banner ── */
.jel-cat-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  padding: 16px 40px;
  background: var(--c-gold-bg);
  border-top: 1px solid var(--c-gold-border);
  border-bottom: 1px solid var(--c-gold-border);
  flex-wrap: wrap;
  gap: 12px;
}
.jel-cat-left {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: var(--fs-base);
  color: var(--c-gold);
}
.jel-cat-clear {
  font-size: var(--fs-xs);
  color: var(--c-text-4);
  letter-spacing: var(--ls-wide);
  text-decoration: none;
  padding: 6px 14px;
  border: 1px solid var(--c-border-2);
  border-radius: 100px;
  transition: color var(--t-fast), border-color var(--t-fast);
}
.jel-cat-clear:hover { color: var(--c-text); border-color: var(--c-text-4); }

/* ── Main content ── */
.jel-main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 56px 40px 80px;
}

/* ── Section label ── */
.jel-section-label {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 28px;
}
.jel-section-text {
  font-family: var(--font-serif);
  font-size: var(--fs-2xl);
  font-weight: 300;
  color: var(--c-text);
  white-space: nowrap;
}
.jel-section-text em { font-style: italic; color: var(--c-gold); }
.jel-section-line { flex: 1; height: 1px; background: var(--c-bg-3); }
.jel-section-count {
  font-size: var(--fs-xs);
  color: var(--c-text-5);
  letter-spacing: var(--ls-label);
  white-space: nowrap;
}

/* ── Premium grid ── */
.prem-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 56px;
}

.prem-card {
  background: var(--c-bg-2);
  border: 1px solid var(--c-border);
  border-radius: var(--r-xl);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  transition: border-color var(--t-normal), transform var(--t-normal), box-shadow var(--t-normal);
}
.prem-card:hover {
  border-color: var(--c-border-2);
  transform: translateY(-5px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.45);
}

.prem-cover {
  position: relative;
  aspect-ratio: 16/9;
  background: var(--c-bg-4);
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.prem-cover-placeholder {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.prem-cover-emoji { font-size: 44px; }
.prem-cover-cat {
  position: absolute; bottom: 12px; left: 12px;
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 12px; border-radius: 100px;
  background: rgba(0,0,0,0.7); border: 1px solid rgba(255,255,255,0.08);
  font-size: var(--fs-xs); color: var(--c-text-2);
  letter-spacing: 0.08em; backdrop-filter: blur(8px);
  text-transform: uppercase;
}
.prem-cover-featured {
  position: absolute; top: 12px; right: 12px;
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 11px; border-radius: var(--r-sm);
  background: rgba(201,160,96,0.88);
  font-size: 9px; color: #0a0a0a;
  letter-spacing: var(--ls-label); text-transform: uppercase;
  font-family: var(--font-mono);
}

.prem-body {
  padding: 22px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.prem-title {
  font-family: var(--font-serif);
  font-size: var(--fs-xl);
  font-weight: 300;
  color: var(--c-text);
  line-height: 1.3;
  margin-bottom: 12px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color var(--t-fast);
}
.prem-card:hover .prem-title { color: var(--c-gold); }

.prem-meta { display: flex; flex-direction: column; gap: 7px; flex: 1; margin-bottom: 16px; }
.prem-meta-row {
  display: flex; align-items: center; gap: 8px;
  font-size: var(--fs-sm); color: var(--c-text-4);
}
.prem-meta-row svg { width: 13px; height: 13px; flex-shrink: 0; color: var(--c-text-5); }

.prem-footer {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 14px; border-top: 1px solid var(--c-bg-3);
}
.prem-price {
  font-family: var(--font-serif);
  font-size: var(--fs-xl); font-weight: 300;
}
.prem-price.free { color: var(--c-green); }
.prem-price.paid { color: var(--c-text); }
.prem-org {
  font-size: var(--fs-xs); color: var(--c-text-5);
  max-width: 120px; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}

/* ── Standard list ── */
.std-section {
  background: var(--c-bg-2);
  border: 1px solid var(--c-bg-3);
  border-radius: var(--r-lg);
  overflow: hidden;
}
.std-header {
  padding: 11px 22px; border-bottom: 1px solid var(--c-bg-3);
  font-size: var(--fs-label); color: var(--c-text-5);
  letter-spacing: var(--ls-label); text-transform: uppercase;
  display: grid;
  grid-template-columns: 1fr 130px 120px 90px;
  gap: 12px; align-items: center;
}
.std-item {
  display: grid;
  grid-template-columns: 1fr 130px 120px 90px;
  gap: 12px; align-items: center;
  padding: 16px 22px;
  border-bottom: 1px solid #0d0d0d;
  text-decoration: none;
  transition: background var(--t-fast);
}
.std-item:last-child { border-bottom: none; }
.std-item:hover { background: rgba(255,255,255,0.018); }

.std-title-wrap { min-width: 0; }
.std-title {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  margin-bottom: 4px;
  transition: color var(--t-fast);
}
.std-item:hover .std-title { color: var(--c-text); }
.std-cat { font-size: 10px; color: var(--c-text-5); letter-spacing: 0.06em; }
.std-date { font-size: var(--fs-sm); color: var(--c-text-5); }
.std-location { font-size: var(--fs-sm); color: var(--c-text-5); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.std-price { font-size: var(--fs-sm); color: var(--c-text-4); text-align: right; }
.std-price.free { color: var(--c-green); }

/* ── Empty ── */
.jel-empty {
  text-align: center; padding: 72px 20px;
  border: 1px solid var(--c-bg-3); border-radius: var(--r-lg);
  background: var(--c-bg-2);
}
.jel-empty-title {
  font-family: var(--font-serif);
  font-size: var(--fs-xl); font-weight: 300;
  color: var(--c-text-4); margin-bottom: 8px;
}
.jel-empty-sub { font-size: var(--fs-sm); color: var(--c-text-5); line-height: 1.8; }

/* ── Responsive ── */
@media (max-width: 960px) {
  .prem-grid  { grid-template-columns: repeat(2, 1fr); }
  .jel-hero   { padding: 100px 24px 48px; }
  .jel-main   { padding: 44px 24px 60px; }
  .jel-cat-banner { padding: 14px 24px; }
  .std-header { display: none; }
  .std-item   { grid-template-columns: 1fr 80px; }
  .std-date, .std-location { display: none; }
}
@media (max-width: 560px) {
  .prem-grid { grid-template-columns: 1fr; }
}
